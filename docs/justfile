# Docs task runner
# Run `just --list` to see the recipes in this file.
# Run from docs/, or from the repo root as `just docs/<recipe>`.

# Source of truth for the RPi camera plugin's OpenAPI schema (sister repo). Pinned to a
# release so the drift check only fails when the pin moves; Renovate bumps it.
# NOTE: the committed schema text is knowingly stale: it still carries the pre-rename names,
# because the newest release (v0.6.2) predates the rename and ships openapi.rpi-cam.json.
# TODO(drop-by 2027-01-31): once CMLPlatform/r9cam publishes a release with openapi.r9cam.json,
# set the repo to CMLPlatform/r9cam, the file to openapi.r9cam.json and the version to that
# release, and rename the Renovate depName and matchPackageNames in .github/renovate.json.
r9cam_plugin_repo := "CMLPlatform/relab-rpi-cam-plugin"
r9cam_plugin_version := "v0.6.2"
r9cam_schema_file := "openapi.rpi-cam.json"
r9cam_schema_url := "https://raw.githubusercontent.com/" + r9cam_plugin_repo + "/" + r9cam_plugin_version + "/" + r9cam_schema_file
r9cam_schema_path := "public/api/schemas/openapi.r9cam.json"

import '../playwright.just'

# Show available recipes
default:
    @just --list

# Install dependencies
install:
    pnpm install --frozen-lockfile

# Upgrade Astro and its official integrations, then apply the in-range pnpm updates.
# This uses `pnpm up` without --latest, so majors stay intentional: opt in via Renovate.
[doc('Upgrade Astro and its integrations, then apply in-range pnpm updates')]
update:
    pnpm dlx @astrojs/upgrade
    pnpm up
    pnpm dedupe

# Start the dev server with live reload
dev:
    pnpm run dev

# Build the static docs site
build:
    pnpm run build

# Run the quality gate. `test-ci` exercises the build itself.
check:
    pnpm run lint
    pnpm run typecheck

# Auto-fix lint issues and format code
fix:
    pnpm run fix

# Run the Vitest unit tests over src/lib. `test-e2e` covers the pages and components.
[doc('Run the Vitest unit tests over src/lib')]
test:
    pnpm run test

# Run the browser E2E tests against a fresh build: smoke, a11y, visual, and theme
test-e2e: build (_browsers "chromium")
    pnpm run test:e2e

# Refresh the committed RPi camera plugin OpenAPI schema from its source repo
r9cam-schema:
    curl -fsSL {{ r9cam_schema_url }} -o {{ r9cam_schema_path }}

# Fail if the committed RPi camera plugin schema has drifted from its source repo
r9cam-schema-check:
    @curl -fsSL {{ r9cam_schema_url }} | diff -u {{ r9cam_schema_path }} - \
        || { echo "❌ {{ r9cam_schema_path }} is stale — run 'just docs/r9cam-schema'"; exit 1; }

# Run the CI test suite: build, E2E, and link check. The pnpm chain runs Playwright
# directly, so the browser bootstrap is a dependency here too.
[doc('Run the CI test suite: build, E2E, and link check')]
test-ci: r9cam-schema-check (_browsers "chromium")
    pnpm run test:ci

# Clean caches and build artifacts
clean:
    rm -rf .astro dist node_modules playwright-report test-results
