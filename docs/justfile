# Docs task runner
# Run `just --list` to see the recipes in this file.
# Run from docs/, or from the repo root as `just docs/<recipe>`.

# Source of truth for the RPi camera plugin's OpenAPI schema (sister repo).
rpi_cam_schema_url := "https://raw.githubusercontent.com/CMLPlatform/relab-rpi-cam-plugin/main/openapi.rpi-cam.json"
rpi_cam_schema_path := "public/api/schemas/openapi.rpi-cam.json"

import '../playwright.just'

# Show available recipes
default:
    @just --list

# Install dependencies
install:
    pnpm install --frozen-lockfile

# Upgrade Astro and its official integrations, then apply the in-range pnpm updates.
# This uses `pnpm up` without --latest, so majors stay intentional: opt in via Renovate.
update:
    pnpm dlx @astrojs/upgrade
    pnpm up
    pnpm dedupe

# Start the dev server with live reload
dev:
    pnpm run dev

# Lint the code
lint:
    pnpm run lint

# Run static type checks
typecheck:
    pnpm run typecheck

# Build the static docs site
build:
    pnpm run build

# Run the quality gate. `test-ci` exercises the build itself.
check: lint typecheck

# Auto-format the code and the markdown
format:
    pnpm run format

# Auto-fix lint issues and format code
fix:
    pnpm run fix

# Run the Vitest unit tests over src/lib. `test-e2e` covers the pages and components.
test:
    pnpm run test

# Run the browser E2E tests against a fresh build: smoke, a11y, visual, and theme
test-e2e: build (_browsers "chromium")
    pnpm run test:e2e

# Refresh the committed RPi camera plugin OpenAPI schema from its source repo
rpi-cam-schema:
    curl -fsSL {{ rpi_cam_schema_url }} -o {{ rpi_cam_schema_path }}

# Fail if the committed RPi camera plugin schema has drifted from its source repo
rpi-cam-schema-check:
    @curl -fsSL {{ rpi_cam_schema_url }} | diff -u {{ rpi_cam_schema_path }} - \
        || { echo "❌ {{ rpi_cam_schema_path }} is stale — run 'just docs/rpi-cam-schema'"; exit 1; }

# Run the CI test suite: build, E2E, and link check. The pnpm chain runs Playwright
# directly, so the browser bootstrap is a dependency here too.
test-ci: rpi-cam-schema-check (_browsers "chromium")
    pnpm run test:ci

# Run the full CI pipeline locally
ci: check test-ci

# Clean caches and build artifacts
clean:
    rm -rf .astro dist node_modules playwright-report test-results
