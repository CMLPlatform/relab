# Docs Task Runner
# Run `just --list` to see all available commands
# Run from root: `just docs/<recipe>` or from docs/: `just <recipe>`

# Source of truth for the RPi camera plugin's OpenAPI schema (sister repo).
rpi_cam_schema_url := "https://raw.githubusercontent.com/CMLPlatform/relab-rpi-cam-plugin/main/openapi.rpi-cam.json"
rpi_cam_schema_path := "public/api/schemas/openapi.rpi-cam.json"

import '../playwright.just'

# Show available recipes
default:
    @just --list

# Install dependencies
install:
    pnpm install --frozen-lockfile

# Update dependencies (Astro upgrade + in-range pnpm updates + dedupe the tree)
# Uses `pnpm up` without --latest so majors stay intentional (opt in via Renovate PRs).
update:
    pnpm dlx @astrojs/upgrade
    pnpm up
    pnpm dedupe

# Start development server with live reload
dev:
    pnpm run dev

# Run lint checks
lint:
    pnpm run lint

# Run static type checks
typecheck:
    pnpm run typecheck

# Build the static docs site
build:
    pnpm run build

# Run lint + typecheck (the build itself is exercised by `test-ci`)
check: lint typecheck

# Auto-format docs code and markdown
format:
    pnpm run format

# Auto-fix lint issues and format code
fix:
    pnpm run fix

# Run Vitest unit tests (src/lib logic; pages/components are covered by `test-e2e`)
test:
    pnpm run test

# Browser end-to-end tests against a fresh build: smoke + a11y + visual + theme
test-e2e: build (_browsers "chromium")
    pnpm run test:e2e

# Refresh the committed RPi camera plugin OpenAPI schema from its source repo
rpi-cam-schema:
    curl -fsSL {{ rpi_cam_schema_url }} -o {{ rpi_cam_schema_path }}

# Fail if the committed RPi camera plugin schema has drifted from its source repo
rpi-cam-schema-check:
    @curl -fsSL {{ rpi_cam_schema_url }} | diff -u {{ rpi_cam_schema_path }} - \
        || { echo "❌ {{ rpi_cam_schema_path }} is stale — run 'just docs/rpi-cam-schema'"; exit 1; }

# Run the docs CI test suite (build + e2e + link check). The pnpm chain runs
# Playwright directly, so the browser bootstrap is a dependency here too.
test-ci: rpi-cam-schema-check (_browsers "chromium")
    pnpm run test:ci

# Run the full docs CI pipeline locally
ci: check test-ci

# Clean caches and generated site output
clean:
    rm -rf .astro dist node_modules playwright-report test-results
