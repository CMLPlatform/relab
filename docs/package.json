{
  "name": "relab-docs",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "contributors": [
    "Simon van Lierde <s.n.van.lierde@cml.leidenuniv.nl>"
  ],
  "scripts": {
    "dev": "astro dev --port 8012 --host 127.0.0.1 --strictPort --mode dev",
    "build": "pnpm run build:prod",
    "build:prod": "astro build --mode prod",
    "build:staging": "astro build --mode staging",
    "build:test": "astro build --mode test",
    "preview": "astro preview --port 8012 --host 127.0.0.1 --strictPort",
    "format": "biome format --write .",
    "fix": "biome check --write . && markdownlint-cli2 --fix",
    "lint": "biome check . && markdownlint-cli2",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:ci": "pnpm run test && pnpm run build && pnpm run test:e2e && pnpm run test:links",
    "test:links": "linkinator ./dist --silent --skip 'mailto:*' --skip 'images/og.png'",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run build:test",
    "ci": "pnpm run check && pnpm run test:ci",
    "audit": "pnpm audit --prod --audit-level moderate"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.3",
    "@astrojs/starlight": "0.41.3",
    "@mermaid-js/layout-elk": "^0.2.2",
    "@scalar/api-reference": "^1.62.5",
    "astro": "catalog:",
    "mermaid": "^11.16.0"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@axe-core/playwright": "catalog:",
    "@biomejs/biome": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "linkinator": "^7.6.1",
    "markdownlint-cli2": "^0.23.0",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  }
}
