---
// Header right side: Starlight's own `social` icons, plus the "Open app" link as
// a primary CTA button, which the built-in component can only draw as an icon.
import Default from '@astrojs/starlight/components/SocialIcons.astro';
---

<Default />
<a href="https://app.cml-relab.org" class="app-cta" rel="noopener noreferrer">Open app</a>

<style>
  .app-cta {
    display: inline-flex;
    align-items: center;
    margin-inline-start: 0.75rem;
    padding: 0.34rem 0.72rem;
    border-radius: var(--radius-control);
    background: var(--relab-brand-primary);
    color: var(--relab-brand-theme-color);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.15s ease;
  }
  .app-cta:hover {
    background: var(--relab-brand-primary-strong);
  }
  /* drop the CTA before the mobile menu collapse to keep the bar uncluttered */
  @media (max-width: 30rem) {
    .app-cta {
      display: none;
    }
  }
</style>
