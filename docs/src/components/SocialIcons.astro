---
// Header right side: GitHub as an icon, and the "Open app" link promoted to a
// primary CTA button (modern docs-header convention). Reads the same `social`
// config as the default component.
import config from 'virtual:starlight/user-config';

const links = config.social ?? [];
const cta = links.find((link) => link.icon === 'external');
const icons = links.filter((link) => link.icon !== 'external');
---

{
  icons.map((link) => (
    <a href={link.href} rel="me" class="sl-flex social-icon" aria-label={link.label}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2C6.475 2 2 6.475 2 12a10 10 0 0 0 6.838 9.488c.5.087.687-.213.687-.476 0-.237-.013-.875-.013-1.725-2.512.463-3.162-.612-3.362-1.175-.113-.288-.6-1.175-1.025-1.413-.35-.187-.85-.65-.013-.662.788-.013 1.35.725 1.538 1.025.9 1.512 2.338 1.087 2.912.825.088-.65.35-1.087.638-1.337-2.225-.25-4.55-1.113-4.55-4.938 0-1.088.387-1.987 1.025-2.688-.1-.25-.45-1.275.1-2.65 0 0 .837-.262 2.75 1.026a9.28 9.28 0 0 1 2.5-.338c.85 0 1.7.112 2.5.337 1.912-1.3 2.75-1.024 2.75-1.024.55 1.375.2 2.4.1 2.65.637.7 1.025 1.587 1.025 2.687 0 3.838-2.337 4.688-4.562 4.938.362.312.675.912.675 1.85 0 1.337-.013 2.412-.013 2.75 0 .262.188.574.688.474A10.016 10.016 0 0 0 22 12c0-5.525-4.475-10-10-10z" />
      </svg>
    </a>
  ))
}
{
  cta && (
    <a href={cta.href} class="app-cta" rel="noopener noreferrer">
      Open app
    </a>
  )
}

<style>
  .social-icon {
    color: var(--sl-color-text-accent);
    padding: 0.5em;
    margin: -0.5em;
  }
  .social-icon:hover {
    color: var(--sl-color-white);
  }
  .app-cta {
    display: inline-flex;
    align-items: center;
    margin-inline-start: 0.75rem;
    padding: 0.34rem 0.72rem;
    border-radius: var(--radius-control);
    background: var(--relab-brand-primary);
    color: var(--relab-brand-theme-color);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.15s ease;
  }
  .app-cta:hover {
    background: var(--relab-brand-primary-strong);
  }
  /* drop the CTA before the mobile menu collapse to keep the bar uncluttered */
  @media (max-width: 30rem) {
    .app-cta {
      display: none;
    }
  }
</style>
