---
// The 9R framework drawn as a descending staircase. Names only: the staircase
// shows the order; the tables beneath it on the page carry the definitions
// (Potting et al. 2017, approved verbatim).
const tiers = [
  {
    label: 'Smarter product use and manufacture',
    rungs: [
      { r: 'R0', name: 'Refuse' },
      { r: 'R1', name: 'Rethink' },
      { r: 'R2', name: 'Reduce' },
    ],
  },
  {
    label: 'Extend lifespan of product and its parts',
    rungs: [
      { r: 'R3', name: 'Re-use' },
      { r: 'R4', name: 'Repair' },
      { r: 'R5', name: 'Refurbish' },
      { r: 'R6', name: 'Remanufacture' },
      { r: 'R7', name: 'Repurpose' },
    ],
  },
  {
    label: 'Useful application of materials',
    rungs: [
      { r: 'R8', name: 'Recycle' },
      { r: 'R9', name: 'Recover' },
    ],
  },
];

/** Rank 0-9 across every tier, read straight off the strategy's own number. */
const stepOf = (r: string): number => Number(r.slice(1));
---

<figure class="ladder-figure">
  <p class="ladder-end ladder-end-top">Most circular</p>
  <div class="ladder">
    {
      tiers.map((tier) => (
        <section class="tier" aria-label={tier.label}>
          <h3 class="tier-label">{tier.label}</h3>
          {/* Explicit role: WebKit drops list semantics under list-style: none. */}
          <ol class="rungs" role="list">
            {tier.rungs.map((rung) => (
              /* --step is the rank across all three tiers, so the indent keeps
                 descending across a tier boundary. */
              <li class="rung" style={`--step: ${stepOf(rung.r)}`}>
                <span class="rung-num">{rung.r}</span>
                <span class="rung-name">{rung.name}</span>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </div>
  <p class="ladder-end ladder-end-bottom">Last resort</p>
  <figcaption>
    The ten strategies as a ladder. Each step down keeps less of the product intact, and the three
    groups mark where the loss changes in kind: the product is not made, then the product is kept,
    then only its materials are.
  </figcaption>
</figure>

<style>
  /* Two borders per row draw the staircase: `border-left` is the riser,
     `border-bottom` the tread, and each tread runs to the step's right edge so
     the next riser lands on it. No bar or width encodes "value retained": the
     9R order is ordinal, and a bar would invent a magnitude Potting et al.
     never measured. */
  .ladder-figure {
    --stair: 1.15rem;

    margin: 1.5rem 0 2rem;
  }

  .ladder {
    display: grid;
    gap: 1.4rem;
  }

  /* Each tier is its own flight, set off by a landing (gap, rule, label). */
  .tier {
    display: grid;
    gap: 0.35rem;
    border-top: 1px solid var(--sl-color-hairline, var(--relab-brand-divider));
    padding-top: 0.6rem;
  }

  .tier-label {
    margin: 0;
    font-family: var(--relab-brand-font-mono), monospace;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
    /* Starlight styles content headings heavily; this one is a figure label. */
    border: 0;
    padding: 0;
  }

  .rungs {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Fixed step width, so the right edge steps down in parallel with the left. */
  .rung {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    width: min(22rem, 100%);
    margin-left: calc(var(--step) * var(--stair));
    padding: 0.35rem 0.6rem;
    border-left: 1px solid var(--sl-color-hairline, var(--relab-brand-divider));
    border-bottom: 1px solid var(--sl-color-hairline, var(--relab-brand-divider));
    font-size: 0.95rem;
  }

  .rung-num {
    flex: none;
    width: 1.7rem;
    font-family: var(--relab-brand-font-mono), monospace;
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    color: var(--relab-brand-accent);
  }

  .rung-name {
    font-weight: 600;
  }

  /* Labels for the two ends of the ladder. */
  .ladder-end {
    margin: 0;
    font-family: var(--relab-brand-font-mono), monospace;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }

  .ladder-end-top {
    padding-bottom: 0.5rem;
  }

  /* Indented to meet the foot of the last step. */
  .ladder-end-bottom {
    margin-left: calc(9 * var(--stair));
    padding: 0.5rem 0 0 0.6rem;
  }

  .ladder-figure figcaption {
    margin-top: 1.2rem;
    max-width: 68ch;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--sl-color-gray-3);
  }

  @media (max-width: 50rem) {
    /* Shallower stair: ten wide steps would push the last rung across a phone. */
    .ladder-figure {
      --stair: 0.5rem;
    }

    .rung {
      width: auto;
      margin-right: calc((9 - var(--step)) * var(--stair));
    }
  }
</style>
