{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":approveMajorUpdates", "schedule:weekly"],
  "timezone": "Europe/Amsterdam",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "prConcurrentLimit": 8,
  "pre-commit": {
    "enabled": true
  },
  "minimumReleaseAge": "7 days",
  "labels": ["dependencies"],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "addLabels": ["security"]
  },
  "packageRules": [
    {
      "description": "Non-breaking updates merge themselves once CI is green",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "description": "Expo SDK-managed packages: the SDK pins these, Renovate cannot read bundledNativeModules.json. Dashboard-only so an available bump stays visible; do not approve individually - run `just app/update` (expo install --fix + expo-doctor) at SDK upgrade time. Vulnerability fixes still raise PRs, they override this.",
      "matchFileNames": ["app/package.json"],
      "matchPackageNames": [
        "expo",
        "/^expo($|-)/",
        "@expo/**",
        "react",
        "react-dom",
        "react-native",
        "@types/react",
        "jest-expo",
        "react-native-gesture-handler",
        "react-native-reanimated",
        "react-native-safe-area-context",
        "react-native-screens",
        "react-native-svg",
        "react-native-web"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "One PR per subrepo instead of one per package",
      "groupName": "backend",
      "matchFileNames": ["backend/**"]
    },
    {
      "groupName": "app",
      "matchFileNames": ["app/**"]
    },
    {
      "groupName": "www",
      "matchFileNames": ["www/**"]
    },
    {
      "groupName": "docs",
      "matchFileNames": ["docs/**"]
    },
    {
      "groupName": "repo-tooling",
      "matchFileNames": [
        ".tool-versions",
        ".node-version",
        ".pre-commit-config.yaml",
        ".devcontainer/**",
        "package.json",
        "pnpm-lock.yaml",
        "pyproject.toml",
        "uv.lock"
      ]
    },
    {
      "description": "Batch GitHub Actions updates into one PR",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "Batch container image updates into one PR",
      "matchManagers": ["dockerfile", "docker-compose"],
      "groupName": "container-images"
    },
    {
      "description": "7 days everywhere; config:best-practices only waits 3 days on npm (npm's 72h unpublish window, not a security floor)",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "7 days"
    }
  ]
}
