# syntax=docker/dockerfile:1

# Runtime image for encrypted Relab backups.
FROM postgres:18@sha256:22c89fe0d0f507606260237fd55e51f6137f58b2d5bcf6152242b96d9fe8f9a4

ARG WORKDIR=/opt/relab/backups
ARG APP_USER=backupuser
ARG APP_UID=1001

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates rclone restic \
    && rm -rf /var/lib/apt/lists/* \
    # Postgres ships gosu for its own entrypoint; this image has its own and runs
    # as an unprivileged user, so drop the setuid-capable Go binary.
    && rm -f /usr/local/bin/gosu \
    && useradd --create-home --uid "$APP_UID" --shell /usr/sbin/nologin "$APP_USER" \
    && install -d -o "$APP_UID" -g "$APP_UID" -m 0755 "$WORKDIR"

WORKDIR $WORKDIR

COPY --chmod=755 --chown=$APP_UID:$APP_UID scripts/backup/backup_relab_restic.sh .
COPY --chmod=755 --chown=$APP_UID:$APP_UID scripts/backup/backup_relab_restic_entrypoint.sh .

ENV BACKUP_SCRIPT=$WORKDIR/backup_relab_restic.sh

USER $APP_USER

# Unhealthy when the success stamp is older than two backup intervals — catches
# a hung restic/rclone run (a failed run exits the container via set -e). No
# stamp yet (first backup still running, or BACKUP_ON_START=false) is healthy.
HEALTHCHECK --interval=5m --timeout=10s --retries=3 \
    CMD stamp="${BACKUP_WORK_DIR:-/tmp/relab-backups}/.last-backup-ok"; \
        [ ! -e "$stamp" ] || [ "$(date +%s)" -lt "$(( $(stat -c %Y "$stamp") + 2 * ${BACKUP_INTERVAL_SECONDS:-86400} ))" ]
