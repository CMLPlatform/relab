<mj-attributes>
  <mj-all
    font-family="{{brand:--r9lab-brand-font}}, -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif"
  />
  <mj-text font-size="15px" color="{{brand:--r9lab-brand-text}}" line-height="1.6" />
  <mj-button
    background-color="{{brand:--r9lab-brand-primary}}"
    color="#ffffff"
    font-size="15px"
    font-weight="500"
    border-radius="12px"
    inner-padding="12px 28px"
  />
</mj-attributes>
<mj-style>
  /* Styled alt text so a blocked/missing wordmark image degrades to a neat
     "R9lab" instead of a broken-image icon (the alt text is the product name). */
  .wordmark-fallback img {
    font-family: -apple-system, "Segoe UI", Arial, sans-serif !important;
    font-weight: 600 !important;
    letter-spacing: -0.5px !important;
    color: {{brand:--r9lab-brand-primary}} !important;
  }
  .footer-text {
    font-size: 12px;
    color: {{brand:--r9lab-brand-accent}};
  }
</mj-style>
