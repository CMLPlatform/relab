<mj-attributes>
  <mj-all
    font-family="{{brand:--relab-brand-font}}, -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif"
  />
  <mj-text font-size="15px" color="{{brand:--relab-brand-text}}" line-height="1.6" />
  <mj-button
    background-color="{{brand:--relab-brand-primary}}"
    color="#ffffff"
    font-size="15px"
    font-weight="500"
    border-radius="14px"
    inner-padding="12px 28px"
  />
</mj-attributes>
<mj-style>
  /* Styled alt text so a blocked/missing wordmark image degrades to a neat
     serif "R9lab" instead of a broken-image icon. */
  .wordmark-fallback img {
    font-family: Georgia, "Times New Roman", serif !important;
    font-weight: 600 !important;
    letter-spacing: -0.5px !important;
    color: {{brand:--relab-brand-primary}} !important;
  }
  .footer-text {
    font-size: 12px;
    color: {{brand:--relab-brand-accent}};
  }
</mj-style>
