<mj-section background-color="{{brand:--relab-brand-surface}}" padding="28px 40px 16px">
  <mj-column>
    <mj-image
      src="https://cml-relab.org/images/wordmark.png"
      alt="Relab"
      css-class="wordmark-fallback"
      width="170px"
      align="left"
      padding="0"
      font-size="27px"
      font-weight="600"
    />
    <mj-text
      align="left"
      padding-top="10px"
      font-size="11px"
      letter-spacing="2px"
      color="{{brand:--relab-brand-accent}}"
    >
      CIRCULAR-ECONOMY RESEARCH LAB
    </mj-text>
  </mj-column>
</mj-section>
<mj-section background-color="{{brand:--relab-brand-surface}}" padding="0 40px">
  <mj-column>
    <mj-divider border-color="{{brand:--relab-brand-divider}}" border-width="1px" padding="0" />
  </mj-column>
</mj-section>
