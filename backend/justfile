# Backend task runner
# Run `just --list` to see the recipes in this file.
# Run from backend/, or from the repo root as `just backend/<recipe>`.

# Show available recipes
default:
    @just --list

# ============================================================================
# Development
# ============================================================================

# Install and sync dependencies
install:
    uv sync --all-groups --frozen

# Start development server
dev port="8010":
    uv run uvicorn app.main:app --reload --reload-dir app --port {{ quote(port) }}

# ============================================================================
# Linting & Formatting
# ============================================================================

pytest := "uv run pytest"

# Auto-fix lint issues and format code
fix:
    uv run ruff check --fix
    uv run ruff format

# Run the fast quality gate (no database required). `ty` syncs all groups first,
# so optional dependencies resolve.
check: openapi-check datamodel-check email-check
    uv run ruff check
    uv run --all-groups ty check
    uv run ruff format --check

# ============================================================================
# Testing
# ============================================================================

# Run all tests
test *args:
    {{ pytest }} {{ args }}

# Run the tests with a coverage report (format: html for local, xml for CI)
test-cov format="html":
    mkdir -p reports/coverage
    {{ pytest }} --cov --cov-report={{ quote(format) }} --cov-report=term

# Run the unit tests only (fast: no Docker and no database)
test-unit *args:
    {{ pytest }} tests/unit {{ args }}

# Run the database-backed persistence and schema tests
test-integration-db *args:
    {{ pytest }} tests/integration/db tests/integration/core/test_database_operations.py tests/integration/core/test_migrations.py {{ args }}

# Run the API tests only
test-api *args:
    {{ pytest }} tests/integration/api {{ args }}

# Run the cross-boundary flow tests
test-flows *args:
    {{ pytest }} tests/integration/flows {{ args }}

# Run all integration tests in parallel. The workers only pay off across the whole
# suite; for a single file, run `just test <file>` instead.
test-integration *args:
    {{ pytest }} tests/integration -n auto --dist=loadgroup {{ args }}

# Run the CI test suite
test-ci:
    mkdir -p reports/coverage
    {{ pytest }} tests/unit tests/integration -n auto --dist=loadgroup --durations=20 --junitxml=reports/junit.xml --cov --cov-report=xml --cov-report=term

# Run the full CI pipeline locally
ci: check test-ci

# ============================================================================
# Database & Migrations
# ============================================================================

# Apply all pending migrations
migrate:
    uv run alembic upgrade head

# Create a migration from the current model changes: just migrate-create "description"
migrate-create message:
    uv run alembic revision --autogenerate -m {{ quote(message) }}

# ============================================================================
# Maintenance scripts
# ============================================================================

# Compile MJML email templates to HTML
compile-email:
    ENVIRONMENT=testing uv run python -m scripts.generate.compile_email_templates

# Fail if the committed email HTML differs from a fresh compile
email-check:
    ENVIRONMENT=testing uv run python -m scripts.generate.compile_email_templates --check

# Export OpenAPI schemas consumed by the docs site
openapi:
    uv run python -m scripts.generate.export_openapi

# Fail if the exported docs OpenAPI schemas are stale.
# NOTE: ENVIRONMENT=testing so that CI, which has no .env.dev, reads the committed
# .env.test. The schema output is identical under dev and testing.
openapi-check:
    ENVIRONMENT=testing uv run python -m scripts.generate.export_openapi --check

# Export the ER diagrams and dataset codebook the docs site imports
datamodel:
    ENVIRONMENT=testing uv run python -m scripts.generate.export_datamodel

# Fail if the generated docs data-model partials are stale
datamodel-check:
    ENVIRONMENT=testing uv run python -m scripts.generate.export_datamodel --check

# Build a publishable dataset release directory. A verification failure aborts the build.
# Contributor consent decides the scope; --owner only narrows within it.
# The pseudonym salt comes from $RELAB_PSEUDONYM_SALT, or else from
# secrets/<env>/dataset_pseudonym_salt.
#
# Usage:     just release-build --software-doi 10.5281/zenodo.NNNNNNN [--out DIR] [--owner USERNAME] [--doi 10.5281/zenodo.NNNNNNN]
# Exclude:   --exclude-owner USERNAME | --exclude-product ID | --exclude-name-word WORD | --no-name-filter
# Dry run:   just release-build --inventory   (every account, writes nothing)
release-build *args:
    uv run python -m scripts.build_dataset_release {{ args }}

# Refresh the committed disposable-email fallback list from the upstream source
refresh-disposable-email-domains:
    uv run python -m scripts.maintenance.refresh_disposable_email_domains

# Refresh the committed common-password fallback list from the pinned upstream source
refresh-common-passwords:
    uv run python -m scripts.maintenance.refresh_common_passwords

# Run the k6 baseline performance suite (requires k6 on the host)
perf-baseline:
    mkdir -p reports/performance
    k6 run --summary-export reports/performance/latest-k6-summary.json perf/k6-baseline.js

ci_compose := "docker compose -p relab_test -f ../compose.yaml -f ../compose.ci.yaml"
# Pinned by digest: a moving :latest silently changes the measurement tool
# between runs, which is the one variable a latency baseline must hold still.
k6_docker_image := "grafana/k6:2.2.0@sha256:5221b620a4f874faff6e32ba597aa667c058391fe4898b1c6f6377f062c6cdec"

# Run the k6 baseline suite against the Docker CI stack.
# Start and seed the CI backend stack first; this recipe does not.
_perf-ci media_url="" base_url="http://api:8000":
    #!/usr/bin/env bash
    set -euo pipefail
    media_url={{ quote(media_url) }}
    if [ -z "$media_url" ]; then
        echo "→ Discovering a seeded media URL from the CI stack..."
        media_path="$({{ ci_compose }} exec -T api python -c 'import json, urllib.request; page = json.load(urllib.request.urlopen("http://localhost:8000/v1/products?size=100")); print(next((item["thumbnail_url"] for item in page["items"] if item.get("thumbnail_url")), ""))' | tr -d '[:space:]')"
        if [ -z "$media_path" ]; then
            echo "✗ No seeded media found. Run 'just _docker-ci-migrate-dummy' first, or pass media_url explicitly." >&2
            exit 1
        fi
        media_url="{{ base_url }}${media_path}"
    fi
    echo "→ media_url_read target: $media_url"
    mkdir -p reports/performance
    docker run --rm \
        --user "$(id -u):$(id -g)" \
        --network relab_test_edge \
        -v "$PWD/perf:/perf:ro" \
        -v "$PWD/reports/performance:/reports" \
        -e BASE_URL={{ quote(base_url) }} \
        -e PERF_USER_EMAIL="e2e-admin@example.com" \
        -e PERF_USER_PASSWORD="E2eTestPass123!" \
        -e PERF_MEDIA_URL="$media_url" \
        {{ k6_docker_image }} run --summary-export /reports/latest-k6-summary.json /perf/k6-baseline.js

# Write a dated CI baseline report from the latest k6 JSON summary export
_perf-report-ci date="" base_url="http://api:8000":
    #!/usr/bin/env bash
    set -euo pipefail
    report_date={{ quote(date) }}
    if [ -z "$report_date" ]; then
        report_date="$(date +%F)"
    fi
    python3 -m scripts.perf.perf_ci write-report --date "$report_date" --base-url {{ quote(base_url) }}

# Recalibrate the p95 thresholds in perf/k6-baseline.js from the latest k6 summary
_perf-thresholds-apply headroom="1.15":
    #!/usr/bin/env bash
    set -euo pipefail
    python3 -m scripts.perf.perf_ci apply-thresholds {{ quote(headroom) }}

# ============================================================================
# Maintenance
# ============================================================================

# Update the dependency lockfile
update:
    uv lock --upgrade

# Clean caches and build artifacts
clean:
    rm -rf __pycache__ .pytest_cache .ruff_cache htmlcov .coverage reports/coverage
    find . -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true
    find . -type f -name "*.pyc" -delete 2>/dev/null || true

# ============================================================================
# Security
# ============================================================================

# Scan Python dependencies for known CVEs (scope: runtime or all groups)
audit scope="runtime":
    #!/usr/bin/env bash
    set -euo pipefail
    scope={{ quote(scope) }}
    case "$scope" in
      runtime) flag="--no-default-groups" ;;
      all) flag="" ;;
      *) echo "scope must be 'runtime' or 'all'"; exit 1 ;;
    esac
    uv audit --preview-features audit --frozen $flag
