{
  "name": "relab-app",
  "main": "expo-router/entry",
  "version": "0.2.0",
  "scripts": {
    "dev": "expo start --web --port 8011",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --port 8011",
    "check": "pnpm run lint && pnpm run typecheck",
    "lint": "biome check . && pnpm run lint:react",
    "lint:react": "eslint --cache --max-warnings=0 src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "fix": "biome check --write . && eslint --cache --fix src --ext .ts,.tsx",
    "test": "jest --config jest.config.cjs",
    "test:unit": "jest --config jest.config.cjs --selectProjects unit",
    "test:integration": "jest --config jest.config.cjs --selectProjects integration",
    "test:watch": "jest --config jest.config.cjs --watchAll",
    "test:ci": "jest --config jest.config.cjs --ci --coverage",
    "build": "pnpm run build:web",
    "build:web": "expo export -p web -c",
    "profile:compiler:web": "ENVIRONMENT=production expo start --web --port 8011 --clear",
    "audit": "pnpm audit --prod --audit-level moderate",
    "test:e2e": "playwright test",
    "test:e2e:cross-browser": "playwright test --project=chromium --project=firefox --project=webkit --project=mobile-chrome --project=mobile-safari",
    "test:e2e:ui": "playwright test --ui",
    "ci": "pnpm run check && pnpm run test:ci",
    "codegen:api": "openapi-typescript ${EXPO_PUBLIC_API_URL:-http://127.0.0.1:8010}/openapi.json -o src/types/api.generated.ts",
    "codegen:api:redact": "pnpm run codegen:api && node scripts/redact_api.mjs",
    "codegen": "pnpm run codegen:api:redact"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.2",
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.3",
    "@react-navigation/elements": "^2.9.26",
    "@react-navigation/native": "^7.3.4",
    "@tanstack/react-query": "^5.100.1",
    "expo": "~57.0.1",
    "expo-auth-session": "~57.0.1",
    "expo-blur": "~57.0.0",
    "expo-constants": "~57.0.2",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-image": "~57.0.0",
    "expo-image-manipulator": "~57.0.1",
    "expo-image-picker": "~57.0.1",
    "expo-linear-gradient": "~57.0.0",
    "expo-linking": "~57.0.1",
    "expo-router": "~57.0.2",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.1",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-video": "^57.0.0",
    "expo-web-browser": "~57.0.0",
    "hls.js": "^1.6.16",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.73.1",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-paper": "^5.15.1",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.0",
    "use-debounce": "^10.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@biomejs/biome": "catalog:",
    "@jest/globals": "~29.7.0",
    "@playwright/test": "catalog:",
    "@react-native/jest-preset": "^0.86.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.17",
    "@typescript-eslint/parser": "^8.62.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "baseline-browser-mapping": "^2.10.40",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.0",
    "jest-junit": "^17.0.0",
    "msw": "^2.14.6",
    "openapi-typescript": "^7.13.0",
    "serve": "^14.2.6",
    "ts-node": "^10.9.2",
    "typescript": "catalog:"
  },
  "private": true
}
