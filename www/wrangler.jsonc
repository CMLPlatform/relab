{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static assets only, no Worker script. The name is a placeholder: deploy-sites.yml
  // passes --name per environment, and infra/cloudflare binds each one to its hostname.
  "name": "relab-www",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Served on the custom domain alone.
  "workers_dev": false,
  "preview_urls": false
}
