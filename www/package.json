  "scripts": {
    "dev": "astro dev --port 8013 --host 127.0.0.1 --strictPort",
    "build": "astro build",
    "preview": "astro preview --port 8013 --host 127.0.0.1 --strictPort",
    "preview:built": "astro preview --port 18013 --host 127.0.0.1 --strictPort",
    "fix": "biome check --write .",
    "lint": "biome check --error-on-warnings .",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@axe-core/playwright": "catalog:",
    "@biomejs/biome": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "4.1.11",
    "happy-dom": "20.14.5",
    "typescript": "catalog:",
    "vitest": "4.1.11"
  }
