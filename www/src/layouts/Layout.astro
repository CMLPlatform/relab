---

import '@/styles/brand.css';
import '@/styles/global.css';

import SiteFooter from '@/components/SiteFooter.astro';
import { getPublicSiteConfig } from '@/config/public.ts';
import { siteLinks, siteMeta } from '@/copy/site-meta.ts';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noIndex?: boolean;
}

const {
  title,
  description = siteMeta.defaultDescription,
  image = '/images/logo.png',
  noIndex = false,
} = Astro.props;

const publicSiteConfig = getPublicSiteConfig();
// siteUrl is a required, validated env var, so these URLs always resolve.
const canonicalUrl = new URL(Astro.url.pathname, publicSiteConfig.siteUrl).toString();
const socialImage = new URL(image, publicSiteConfig.siteUrl).toString();
let pageTitle = `${title} | ${siteMeta.name}`;
if (title === siteMeta.title || title.includes(siteMeta.name)) {
  pageTitle = title;
}
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eef4f7" data-dynamic-theme />
    <link rel="canonical" href={canonicalUrl} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteMeta.title} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link
      rel="preload"
      href="/fonts/ibm-plex-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {/* Resolve theme before first paint to avoid a flash for users whose stored
        preference differs from their OS scheme. A classic external script in
        <head> is render-blocking (same no-flash guarantee as inline) and
        satisfies the CSP script-src 'self' policy, which forbids inline script. */}
    <script is:inline src="/theme-init.js"></script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="site-backdrop" aria-hidden="true">
    </div>

    <main class="page-shell">
      <slot />
    </main>

    <SiteFooter
      contactEmail={publicSiteConfig.contactEmail}
      currentYear={currentYear}
      githubUrl={siteLinks.github}
      linkedInUrl={siteLinks.linkedin}
      youtubeUrl={siteLinks.youtube}
    />

    <script>
      import { initThemeControl } from '@/scripts/theme.ts';

      initThemeControl();
    </script>
  </body>
</html>
