---
// The 9R framework as a compact tier strip.
//
// The `hint` strings are the canonical definitions, Potting et al. 2017, exactly
// as the docs carry them at project/9r-framework. They are one line each and
// live in a popover rather than in body copy, so quoting them here costs no
// page weight and avoids the drift a paraphrase invites. Keep the two copies in
// step: docs/src/content/docs/project/9r-framework.md is the source of record,
// and NineRLadder.test.ts pins the wording on this side.
interface Props {
  docsUrl: string;
}

const { docsUrl } = Astro.props;
const frameworkUrl = `${docsUrl.replace(/\/$/, '')}/project/9r-framework/`;

/** Rank 0-9 across every tier, read straight off the strategy's own number. */
const stepOf = (r: string): number => Number(r.slice(1));

const tiers = [
  {
    label: 'Smarter product use and manufacture',
    rungs: [
      {
        r: 'R0',
        name: 'Refuse',
        hint: 'Make product redundant by abandoning its function or offering the same function with a radically different product.',
      },
      {
        r: 'R1',
        name: 'Rethink',
        hint: 'Make product use more intensive (e.g. sharing, or multi-functional products).',
      },
      {
        r: 'R2',
        name: 'Reduce',
        hint: 'Increase efficiency in manufacture or use by consuming fewer resources and materials.',
      },
    ],
  },
  {
    label: 'Extend lifespan of product and its parts',
    rungs: [
      {
        r: 'R3',
        name: 'Re-use',
        hint: 'Re-use by another consumer of a discarded product still in good condition and fulfilling its original function.',
      },
      {
        r: 'R4',
        name: 'Repair',
        hint: 'Repair and maintenance of a defective product so it can be used with its original function.',
      },
      { r: 'R5', name: 'Refurbish', hint: 'Restore an old product and bring it up to date.' },
      {
        r: 'R6',
        name: 'Remanufacture',
        hint: 'Use parts of a discarded product in a new product with the same function.',
      },
      {
        r: 'R7',
        name: 'Repurpose',
        hint: 'Use a discarded product or its parts in a new product with a different function.',
      },
    ],
  },
  {
    label: 'Useful application of materials',
    rungs: [
      {
        r: 'R8',
        name: 'Recycle',
        hint: 'Process materials to obtain the same (high-grade) or lower (low-grade) quality.',
      },
      { r: 'R9', name: 'Recover', hint: 'Incineration of materials with energy recovery.' },
    ],
  },
];
---

<section class="section nine-r" aria-labelledby="nine-r-heading">
  <h2 id="nine-r-heading">The 9R framework</h2>
  <p class="nine-r-lede">
    Ten strategies, R0 to R9, ordered from smartest to last resort. The higher a product stays on
    the ladder, the more of its value survives. It is the lens Relab reads teardowns through: each
    record shows what a product is made of and how it comes apart, which is what deciding between
    these strategies takes.
  </p>
  <div class="ladder">
    <p class="ladder-end ladder-end-top">Most circular</p>
    {
      tiers.map((tier) => (
        <div class="tier">
          <h3 class="tier-label">{tier.label}</h3>
          {/* Explicit role: WebKit drops list semantics under list-style: none. */}
          <ol class="rungs" role="list">
            {tier.rungs.map((rung) => (
              /* --step is the rung's rank across all three tiers, not within
                 this one: it drives the indent that draws the staircase, so it
                 has to keep descending across a tier boundary. */
              <li class="rung" style={`--step: ${stepOf(rung.r)}`}>
                {/* The <span> carries the hint, not the <li>: it is the focusable
                    trigger, and a focusable list item would be announced twice.
                    `title` is the no-JS fallback; the script lifts it into the
                    popover and removes it so the two never double up. */}
                <span class="rung-body" data-rung-hint={rung.hint} title={rung.hint}>
                  <span class="rung-num">{rung.r}</span>
                  <span class="rung-name">{rung.name}</span>
                </span>
              </li>
            ))}
          </ol>
        </div>
      ))
    }
    <p class="ladder-end ladder-end-bottom">Last resort</p>
  </div>
  <p class="nine-r-source">
    {/* Explicit space: Astro strips the inter-node newline before the <a>. */}
    After Potting et al. (2017):{' '}
    <a href={frameworkUrl} target="_blank" rel="noopener noreferrer"
      >full definitions in the docs<span class="visually-hidden"> (opens in new tab)</span></a
    >.
  </p>
  <div id="nine-r-popover" class="hint-popover" popover="manual" role="tooltip"></div>
</section>

<script>
  import { createHintPopover, wireHintTrigger } from '@/scripts/popover-hint.ts';

  const hint = createHintPopover(document.getElementById('nine-r-popover'));
  if (hint) {
    for (const rung of document.querySelectorAll<HTMLElement>('[data-rung-hint]')) {
      const text = rung.dataset.rungHint;
      if (!text) {
        continue;
      }
      // Remove the native tooltip only once the popover is live, so a failed
      // script leaves the `title` fallback in place.
      rung.removeAttribute('title');
      rung.setAttribute('tabindex', '0');
      rung.setAttribute('aria-label', `${rung.textContent?.trim()}: ${text}`);
      wireHintTrigger(rung, text, hint);
    }
  }
</script>

<style>
  .nine-r h2 {
    margin: 0 0 0.6rem;
  }

  .nine-r-lede {
    margin: 0 0 1.4rem;
    max-width: 80ch;
    font-size: var(--font-size-body-compact);
    line-height: var(--line-height-body-compact);
    color: var(--color-muted);
  }

  /* An actual staircase, because the framework is an ordinal ladder and the
     old wrapping row of identical chips encoded none of that: every strategy
     looked equally good, and the only clue to the order was reading the
     numbers. Each rung steps one notch further right than the one above, and
     the drawing falls out of two borders per row: `border-left` is the riser,
     `border-bottom` is the tread. Because a tread runs from its own indent to
     the right edge, the next rung's riser always lands on it, so the steps
     connect into one continuous flight without any extra elements.
     Deliberately no bar or width encoding the "value retained": the 9R order
     is ordinal, and a bar would invent a magnitude Potting et al. never
     measured. */
  .ladder {
    --stair: 1.15rem;

    display: grid;
    grid-template-columns: 16rem minmax(0, 1fr);
    column-gap: 1.2rem;
  }

  /* `display: contents` so each tier's label and rungs join the ladder grid
     directly: the label column stays aligned across all three tiers, and the
     staircase in the right column runs unbroken through them. */
  .tier {
    display: contents;
  }

  .tier-label {
    margin: 0;
    padding-top: 0.55rem;
    font-family: var(--relab-brand-font-mono), monospace;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .rungs {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* A fixed step width, so the right edge steps down in parallel with the left
     and the flight reads as stairs. Let the treads run to the column edge
     instead and the whole thing flattens into a ruled table. */
  .rung {
    width: 20rem;
    margin-left: calc(var(--step) * var(--stair));
    border-left: 1px solid var(--color-page-border);
    border-bottom: 1px solid var(--color-page-border);
  }

  /* The trigger fills its step, so the focus ring outlines exactly what is
     focusable and the whole tread is hoverable. `cursor: help` matches the
     flowchart nodes. */
  .rung-body {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.4rem 0.6rem;
    font-size: 0.92rem;
    cursor: help;
  }

  .rung-body:hover {
    background: var(--color-primary-soft);
  }

  /* Which end of the ladder is which, stated rather than implied. Aligned to
     the stair's left edge, in the label register. */
  .ladder-end {
    grid-column: 2;
    margin: 0;
    font-family: var(--relab-brand-font-mono), monospace;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .ladder-end-top {
    padding-bottom: 0.35rem;
  }

  /* Indented to meet the foot of the last step. */
  .ladder-end-bottom {
    margin-left: calc(9 * var(--stair));
    padding: 0.35rem 0 0 0.6rem;
  }

  /* Fixed width so the numbers form a column inside each step rather than
     shifting with the name beside them. */
  .rung-num {
    flex: none;
    width: 1.6rem;
    font-family: var(--relab-brand-font-mono), monospace;
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }

  .rung-name {
    font-weight: 600;
  }

  .nine-r-source {
    margin: 1.2rem 0 0;
    font-size: var(--font-size-meta);
    color: var(--color-muted);
  }

  @media (max-width: 860px) {
    /* One column, and a shallower stair: ten steps at the desktop notch would
       push the last rung most of the way across a phone. The steps still
       descend, just less far. */
    .ladder {
      --stair: 0.5rem;

      grid-template-columns: minmax(0, 1fr);
      row-gap: 0;
    }

    .tier-label {
      padding-top: 1rem;
    }

    .ladder-end {
      grid-column: 1;
    }

    .ladder-end-bottom {
      margin-left: calc(9 * var(--stair));
    }

    /* The step can no longer be a fixed width once the column is a phone. */
    .rung {
      width: auto;
      margin-right: calc((9 - var(--step)) * var(--stair));
    }
  }
</style>
