---
// The 9R framework as a compact tier strip. Names only; the full canonical
// definitions (Potting et al. 2017, approved verbatim) live in the docs at
// project/9r-framework — do not restate them here.
interface Props {
  docsUrl: string;
}

const { docsUrl } = Astro.props;
const frameworkUrl = `${docsUrl.replace(/\/$/, '')}/project/9r-framework/`;

const tiers = [
  {
    label: 'Smarter product use and manufacture',
    rungs: [
      { r: 'R0', name: 'Refuse' },
      { r: 'R1', name: 'Rethink' },
      { r: 'R2', name: 'Reduce' },
    ],
  },
  {
    label: 'Extend lifespan of product and its parts',
    rungs: [
      { r: 'R3', name: 'Re-use' },
      { r: 'R4', name: 'Repair' },
      { r: 'R5', name: 'Refurbish' },
      { r: 'R6', name: 'Remanufacture' },
      { r: 'R7', name: 'Repurpose' },
    ],
  },
  {
    label: 'Useful application of materials',
    rungs: [
      { r: 'R8', name: 'Recycle' },
      { r: 'R9', name: 'Recover' },
    ],
  },
];
---

<section class="card content-reveal nine-r" aria-labelledby="nine-r-heading">
  <p class="nine-r-eyebrow">framework</p>
  <h2 id="nine-r-heading">The 9R framework</h2>
  <p class="nine-r-lede">
    Ten strategies, R0 to R9, ordered from smartest to last resort. The higher a product stays on
    the ladder, the more of its value survives.
  </p>
  {
    tiers.map((tier) => (
      <div class="tier">
        <h3 class="tier-label">{tier.label}</h3>
        {/* Explicit role: WebKit drops list semantics under list-style: none. */}
        <ol class="rungs" role="list">
          {tier.rungs.map((rung) => (
            <li class="rung">
              <span class="rung-num">{rung.r}</span>
              <span class="rung-name">{rung.name}</span>
            </li>
          ))}
        </ol>
      </div>
    ))
  }
  <p class="nine-r-source">
    {/* Explicit space: Astro strips the inter-node newline before the <a>. */}
    After Potting et al. (2017) —{' '}
    <a href={frameworkUrl} target="_blank" rel="noopener noreferrer">full definitions in the docs</a
    >.
  </p>
</section>

<style>
  /* Manila stays small mono text: the eyebrow and the R-numbers, nothing more. */
  .nine-r-eyebrow {
    margin: 0 0 0.35rem;
    font-family: var(--relab-brand-font-mono), monospace;
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .nine-r h2 {
    margin: 0 0 0.6rem;
  }

  .nine-r-lede {
    margin: 0 0 1.4rem;
    max-width: 62ch;
    font-size: var(--font-size-body-compact);
    line-height: var(--line-height-body-compact);
    color: var(--color-muted);
  }

  .tier {
    display: grid;
    grid-template-columns: 16rem 1fr;
    column-gap: 1.2rem;
    align-items: baseline;
    border-top: 1px solid var(--color-page-border);
    padding: 0.7rem 0;
  }

  .tier-label {
    margin: 0;
    font-family: var(--relab-brand-font-mono), monospace;
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .rungs {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .rung {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--color-page-border);
    border-radius: var(--radius-control);
    font-size: 0.88rem;
  }

  .rung-num {
    font-family: var(--relab-brand-font-mono), monospace;
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }

  .rung-name {
    font-weight: 600;
  }

  .nine-r-source {
    margin: 1.2rem 0 0;
    font-size: var(--font-size-meta);
    color: var(--color-muted);
  }

  @media (max-width: 860px) {
    .tier {
      grid-template-columns: 1fr;
      row-gap: 0.4rem;
    }
  }
</style>
