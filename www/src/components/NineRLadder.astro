---
// The 9R ladder — canonical names and descriptions after Potting et al. (2017).
// Content is approved verbatim: do not paraphrase, reorder, or "improve" it.
const tiers = [
  {
    label: 'Smarter product use and manufacture',
    rungs: [
      {
        r: 'R0',
        name: 'Refuse',
        text: 'Make product redundant by abandoning its function or offering the same function with a radically different product.',
      },
      {
        r: 'R1',
        name: 'Rethink',
        text: 'Make product use more intensive (e.g. sharing, or multi-functional products).',
      },
      {
        r: 'R2',
        name: 'Reduce',
        text: 'Increase efficiency in manufacture or use by consuming fewer resources and materials.',
      },
    ],
  },
  {
    label: 'Extend lifespan of product and its parts',
    rungs: [
      {
        r: 'R3',
        name: 'Re-use',
        text: 'Re-use by another consumer of a discarded product still in good condition and fulfilling its original function.',
      },
      {
        r: 'R4',
        name: 'Repair',
        text: 'Repair and maintenance of a defective product so it can be used with its original function.',
      },
      {
        r: 'R5',
        name: 'Refurbish',
        text: 'Restore an old product and bring it up to date.',
      },
      {
        r: 'R6',
        name: 'Remanufacture',
        text: 'Use parts of a discarded product in a new product with the same function.',
      },
      {
        r: 'R7',
        name: 'Repurpose',
        text: 'Use a discarded product or its parts in a new product with a different function.',
      },
    ],
  },
  {
    label: 'Useful application of materials',
    rungs: [
      {
        r: 'R8',
        name: 'Recycle',
        text: 'Process materials to obtain the same (high-grade) or lower (low-grade) quality.',
      },
      {
        r: 'R9',
        name: 'Recover',
        text: 'Incineration of materials with energy recovery.',
      },
    ],
  },
];
---

<section class="card content-reveal nine-r" aria-labelledby="nine-r-heading">
  <p class="nine-r-eyebrow">framework</p>
  <h2 id="nine-r-heading">The 9R framework</h2>
  <p class="nine-r-lede">
    Ten strategies, R0 to R9, ordered from smartest to last resort. The higher a product stays on
    the ladder, the more of its value survives.
  </p>
  {
    tiers.map((tier) => (
      <div class="tier">
        <h3 class="tier-label">{tier.label}</h3>
        <ol class="rungs">
          {tier.rungs.map((rung) => (
            <li class="rung" style={`--i: ${Number(rung.r.slice(1))}`}>
              <span class="rung-num">{rung.r}</span>
              <span class="rung-name">{rung.name}</span>
              <p class="rung-desc">{rung.text}</p>
            </li>
          ))}
        </ol>
      </div>
    ))
  }
  <p class="nine-r-source">
    The 9R framework, after Potting et al. (2017),
    <a
      href="https://www.pbl.nl/uploads/default/downloads/pbl-2016-circular-economy-measuring-innovation-in-product-chains-2544.pdf"
      target="_blank"
      rel="noopener noreferrer"><cite>Circular Economy: Measuring Innovation in the Product Chain</cite></a
    > (PBL).
  </p>
</section>

<style>
  /* Manila stays small mono text: the eyebrow and the R-numbers, nothing more. */
  .nine-r-eyebrow {
    margin: 0 0 0.35rem;
    font-family: var(--relab-brand-font-mono), monospace;
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .nine-r h2 {
    margin: 0 0 0.6rem;
  }

  .nine-r-lede {
    margin: 0 0 1.6rem;
    max-width: 62ch;
    font-size: var(--font-size-body-compact);
    line-height: var(--line-height-body-compact);
    color: var(--color-muted);
  }

  .tier {
    border-top: 1px solid var(--color-page-border);
    padding-top: 0.9rem;
    margin-top: 1.1rem;
  }

  .tier:first-of-type {
    margin-top: 0;
  }

  .tier-label {
    margin: 0 0 0.5rem;
    font-family: var(--relab-brand-font-mono), monospace;
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .rungs {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Each rung is a flat grid row; the hairlines between rungs draw the ladder
     itself, and the stepped inset (--i is the R-number) narrows it downward:
     the lower the rung, the less of the product's value is left. */
  .rung {
    display: grid;
    grid-template-columns: 3.4rem 10.5rem 1fr;
    column-gap: 1.2rem;
    align-items: baseline;
    padding: 0.55rem 0;
    margin-left: calc(var(--i) * 0.35rem);
  }

  .rung + .rung {
    border-top: 1px solid var(--color-page-border);
  }

  .rung-num {
    font-family: var(--relab-brand-font-mono), monospace;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }

  .rung-name {
    font-weight: 600;
  }

  .rung-desc {
    margin: 0;
    max-width: 60ch;
    font-size: var(--font-size-body-compact);
    line-height: var(--line-height-body-compact);
  }

  .nine-r-source {
    margin: 1.6rem 0 0;
    font-size: var(--font-size-meta);
    color: var(--color-muted);
  }

  @media (max-width: 860px) {
    .rung {
      grid-template-columns: 3.4rem 1fr;
      row-gap: 0.15rem;
      margin-left: 0;
    }

    .rung-desc {
      grid-column: 2;
    }
  }
</style>
