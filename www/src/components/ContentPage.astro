---

interface Props {
  title: string;
  intro?: string;
  meta?: string;
}

const { title, intro, meta } = Astro.props;
---

<div class="content-page grid gap-4">
  <section class="page-intro content-reveal">
    <h1>{title}</h1>
    {meta && <p class="page-meta">{meta}</p>}
    {intro && <p>{intro}</p>}
  </section>

  <slot />
</div>
