---

import GithubIcon from '@/assets/icons/brand/github.svg';
import LinkedinIcon from '@/assets/icons/brand/linkedin.svg';
import YoutubeIcon from '@/assets/icons/brand/youtube.svg';
// `?url`: hashed URLs under /_astro/ (immutable cache headers) rather than
// Astro's inlining SVG component — CSS paints only one of the two variants.
import wordmarkUrl from '@/assets/images/wordmark.svg?url';
import wordmarkDarkUrl from '@/assets/images/wordmark-dark.svg?url';

import ThemeControl from './ThemeControl.astro';

interface Props {
  contactEmail: string;
  currentYear: number;
  githubUrl: string;
  linkedInUrl: string;
  youtubeUrl: string;
}

const { contactEmail, currentYear, githubUrl, linkedInUrl, youtubeUrl } = Astro.props;
---

<footer class="site-footer">
  <div class="frame site-footer-inner">
    <div class="footer-meta">
      {/* width/height reserve the box before the SVG loads (the artwork is
          810x256, so 26px tall is 82px wide); CSS still sizes it. */}
      <a href="/" class="footer-brand" aria-label="Relab home">
        <img class="brand-light" src={wordmarkUrl} alt="Relab" width="82" height="26" />
        <img
          class="brand-dark"
          src={wordmarkDarkUrl}
          alt=""
          aria-hidden="true"
          width="82"
          height="26"
        />
      </a>
      <a
        href="/privacy"
        class="text-[var(--color-muted)] no-underline font-medium text-[0.95rem]"
        aria-label="Read the Relab privacy policy"
      >
        Privacy policy
      </a>
      <p class="footer-copy">© {currentYear} CML, Leiden University</p>
    </div>

    <nav class="footer-links" aria-label="Footer">
      <a
        href={`mailto:${contactEmail}`}
        class="text-[var(--color-muted)] no-underline font-medium text-[0.95rem]"
      >
        {contactEmail}
      </a>
      <div class="inline-flex items-center gap-[0.15rem] footer-social">
        <a
          href={githubUrl}
          class="inline-flex items-center justify-center w-11 h-11 text-[var(--color-muted)]"
          aria-label="GitHub (opens in new tab)"
          title="GitHub"
          target="_blank"
          rel="noopener noreferrer"
        >
          <GithubIcon class="w-[1.18rem] h-[1.18rem] fill-current" aria-hidden="true" />
        </a>
        <a
          href={linkedInUrl}
          class="inline-flex items-center justify-center w-11 h-11 text-[var(--color-muted)]"
          aria-label="LinkedIn (opens in new tab)"
          title="LinkedIn"
          target="_blank"
          rel="noopener noreferrer"
        >
          <LinkedinIcon class="w-[1.18rem] h-[1.18rem] fill-current" aria-hidden="true" />
        </a>
        <a
          href={youtubeUrl}
          class="inline-flex items-center justify-center w-11 h-11 text-[var(--color-muted)]"
          aria-label="YouTube (opens in new tab)"
          title="YouTube"
          target="_blank"
          rel="noopener noreferrer"
        >
          <YoutubeIcon class="w-[1.18rem] h-[1.18rem] fill-current" aria-hidden="true" />
        </a>
      </div>
    </nav>

    <div class="footer-theme">
      <ThemeControl />
    </div>
  </div>
</footer>

<style>
  .footer-brand {
    display: inline-flex;
    align-items: center;
  }
  .footer-brand img {
    height: 26px;
    width: auto;
  }
  /* theme-swapped wordmark: teal on light, cyan on dark (system + manual toggle) */
  .footer-brand .brand-light {
    display: block;
  }
  .footer-brand .brand-dark {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .footer-brand .brand-light {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .footer-brand .brand-dark {
      display: block;
    }
  }
  :global(:root[data-theme='dark']) .footer-brand .brand-light {
    display: none;
  }
  :global(:root[data-theme='dark']) .footer-brand .brand-dark {
    display: block;
  }
</style>
