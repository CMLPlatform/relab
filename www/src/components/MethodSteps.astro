---
// The method section: the data-collection workflow as one flowchart.
// Two inlined variants from method-flow.mmd / method-flow-tb.mmd (regeneration
// steps documented there): a horizontal flow for wide and semi-wide screens
// that scales to fit, and a vertical flow for narrow screens where the
// horizontal one would shrink its labels to nothing. Both inherit the page's
// CSS variables and font. Each node carries a <title>: the accessible name and
// the no-JS hover tooltip; method-flow.ts upgrades those into a popover that
// also works on touch and keyboard, across whichever variant is shown.

// NOTE: both variants are inlined (~44KB raw, ~10KB gzip) so the diagram
// renders without JS and themes through the page's CSS vars; shipping a single
// variant would mean injecting the other on the client.
import MethodFlow from '@/assets/method-flow.svg';
import MethodFlowTb from '@/assets/method-flow-tb.svg';
---

<section class="section method-steps" aria-labelledby="method-steps-heading">
  <h2 id="method-steps-heading">From teardown to data</h2>
  <figure class="method-flow">
    <div class="flow-wide"><MethodFlow /></div>
    <div class="flow-narrow"><MethodFlowTb /></div>
    <figcaption>
      The collection workflow, from product intake to the open dataset. Hover or tap a step for
      detail.
    </figcaption>
  </figure>
  <div id="method-flow-popover" class="hint-popover" popover="manual" role="tooltip"></div>
</section>

<script>
  import { initMethodFlow } from '@/scripts/method-flow.ts';

  initMethodFlow();
</script>

<style>
  /* min-width: 0 keeps the flowchart from setting the grid section's
     min-content width and pushing the page sideways. */
  .method-steps {
    min-width: 0;
  }

  .method-steps h2 {
    margin: 0 0 1.4rem;
  }

  .method-flow {
    margin: 0;
  }

  /* Horizontal flow scales to fit its container (no fixed min-width, so it
     never forces a sideways scroll); the vertical flow takes over on narrow
     screens where the horizontal labels would be too small to read. */
  .flow-narrow {
    display: none;
  }

  .flow-wide :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .flow-narrow :global(svg) {
    display: block;
    width: 100%;
    max-width: 18rem;
    height: auto;
    margin: 0 auto;
  }

  @media (max-width: 899px) {
    .flow-wide {
      display: none;
    }
    .flow-narrow {
      display: block;
    }
  }

  .method-flow :global(.node) {
    cursor: help;
  }

  .method-flow :global(.node:focus-visible rect) {
    stroke-width: 2px;
    outline: none;
  }

  .method-flow figcaption {
    margin-top: 0.8rem;
    font-size: var(--font-size-body-compact);
    color: var(--color-muted);
  }

  /* The popover itself is styled globally as `.hint-popover` (components.css),
     shared with the 9R ladder. */
</style>
