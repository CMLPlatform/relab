---
// The method section: the data-collection workflow as one flowchart.
// Two inlined variants from method-flow.mmd / method-flow-tb.mmd (regeneration
// steps documented there): a horizontal flow for wide and semi-wide screens
// that scales to fit, and a vertical flow for narrow screens where the
// horizontal one would shrink its labels to nothing. Both inherit the page's
// CSS variables and font. Each node carries a <title>: the accessible name and
// the no-JS hover tooltip; method-flow.ts upgrades those into a popover that
// also works on touch and keyboard, across whichever variant is shown.

// NOTE: both variants are inlined (~44KB raw, ~10KB gzip) so the diagram
// renders without JS and themes through the page's CSS vars; shipping a single
// variant would mean injecting the other on the client.
import MethodFlow from '@/assets/method-flow.svg';
import MethodFlowTb from '@/assets/method-flow-tb.svg';
---

<section class="section method-steps" aria-labelledby="method-steps-heading">
  <h2 id="method-steps-heading">From teardown to data</h2>
  <figure class="method-flow">
    <div class="flow-wide"><MethodFlow /></div>
    <div class="flow-narrow"><MethodFlowTb /></div>
    <figcaption>
      The collection workflow, from product intake to the open dataset. Hover or tap a step for
      detail.
    </figcaption>
  </figure>
  <div id="method-flow-popover" class="hint-popover" popover="manual" role="tooltip"></div>
</section>

<script>
  import { initMethodFlow } from '@/scripts/method-flow.ts';

  initMethodFlow();
</script>

<style>
  /* min-width: 0 keeps the flowchart from setting the grid section's
     min-content width and pushing the page sideways. */
  .method-steps {
    min-width: 0;
  }

  .method-steps h2 {
    margin: 0 0 1.4rem;
  }

  .method-flow {
    margin: 0;
  }

  /* The horizontal flow's viewBox is 1555 units wide and the page column caps
     at 1248, so fitting it to the column scaled everything to 0.80 and set its
     15px labels at 12px (9.6px at a 1024 viewport). Two changes fix that:

     1. It breaks out of the page column to the viewport, capped at its own
        natural width, so a wide screen renders it at or near 1:1.
     2. Below that it scrolls rather than shrinking further, with a floor that
        keeps the labels at 13px -- the same trade the stats chart makes, and
        the reason that one carries an edge fade too.

     The vertical variant still takes over before the scroll gets long. */
  .flow-narrow {
    display: none;
  }

  .flow-wide {
    width: min(calc(100vw - 3rem), 1555px);
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    overflow-x: auto;
    overscroll-behavior-x: contain;
  }

  .flow-wide :global(svg) {
    display: block;
    width: 100%;
    /* 1555 x 0.867 -- the scale at which the 15px labels land at 13px. */
    min-width: 1348px;
    height: auto;
  }

  /* Scroll affordance, mirroring .stats-chart: fade both edges once the
     diagram can no longer fit, so a cut-off node reads as "there is more". */
  @media (max-width: 1400px) {
    .flow-wide {
      mask-image: linear-gradient(
        to right,
        transparent 0,
        black 1.25rem,
        black calc(100% - 1.25rem),
        transparent 100%
      );
    }
  }

  .flow-narrow :global(svg) {
    display: block;
    width: 100%;
    /* Natural width is 239 units, so 18rem already renders it above 1:1; more
       would set the labels larger than the body text around them. */
    max-width: 18rem;
    height: auto;
    margin: 0 auto;
  }

  /* Raised from 899px: at that width the horizontal flow needed ~470px of
     sideways scroll, which is further than a diagram should ask anyone to
     drag. The vertical variant is legible at its natural size. */
  @media (max-width: 1100px) {
    .flow-wide {
      display: none;
    }
    .flow-narrow {
      display: block;
    }
  }

  .method-flow :global(.node) {
    cursor: help;
  }

  .method-flow :global(.node:focus-visible rect) {
    stroke-width: 2px;
    outline: none;
  }

  .method-flow figcaption {
    margin-top: 0.8rem;
    font-size: var(--font-size-body-compact);
    color: var(--color-muted);
  }

  /* The popover itself is styled globally as `.hint-popover` (components.css),
     shared with the 9R ladder. */
</style>
