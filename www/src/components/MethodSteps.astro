---
// The data-collection workflow.
//
// Hand-built HTML/CSS, not a rendered diagram. It used to be two inlined
// mermaid SVGs (a horizontal one and a vertical one, swapped by viewport), and
// mermaid was the wrong tool for it: the workflow is a straight line, so the
// graph layout engine bought nothing, while its output cost ~44KB of inlined
// SVG, a hand-maintained post-processing ritual to turn baked hex into CSS
// variables and re-insert every accessible name, and two variants to keep in
// step. Worst of all it fixed the type into vector units, so the labels were
// whatever size the viewBox happened to scale to -- 12px on a desktop, 9.6px
// at 1024 -- and no CSS could raise them.
//
// As markup the steps are real text: they scale with the reader's font size,
// reflow at any width, wrap into one column on a phone, need no second variant,
// and carry their own descriptions in the open rather than behind a hover.
//
// assets/method-flow.mmd stays: it is the source for the platform paper's
// figure, which does want a rendered diagram. It is no longer a www dependency.
//
// Descriptions are the same text the SVG carried as per-node <title>s.
interface Props {
  docsUrl: string;
}

const { docsUrl } = Astro.props;
const frameworkUrl = `${docsUrl.replace(/\/$/, '')}/project/9r-framework/`;

const phases = [
  {
    name: 'Intake',
    steps: [
      {
        name: 'Product in',
        detail:
          'A product arrives for teardown: durable goods that hand tools can open non-destructively.',
      },
      {
        name: 'Photograph',
        detail: 'Capture first, before recording anything else, by phone or a fixed camera rig.',
      },
      {
        name: 'Register product',
        detail: 'Create the product record: its type, brand, and model.',
      },
    ],
  },
  {
    // Exactly the two steps the source diagram puts inside its loop subgraph.
    // Nesting sits after it there, so it stays in the third phase here.
    name: 'For each component',
    repeats: true,
    steps: [
      { name: 'Identify', detail: 'Name each component and identify what it is made of.' },
      { name: 'Weigh and measure', detail: 'Record mass and dimensions for every component.' },
    ],
  },
  {
    name: 'Output',
    steps: [
      {
        name: 'Nest into component hierarchy',
        detail: 'Attach each component to its parent; assemblies nest to any depth.',
      },
      {
        name: 'Publish to open dataset',
        detail: 'The record joins the openly licensed dataset, in the app and over the API.',
      },
      {
        name: 'LCA and circular-economy research',
        detail: 'Records support life-cycle assessment and circularity analysis.',
      },
    ],
  },
];
---

<section class="section method-steps" aria-labelledby="method-steps-heading">
  <h2 id="method-steps-heading">From teardown to data</h2>
  <p class="method-lede">
    Every record is built the same way, in three passes: the product is taken in, each component is
    worked through in turn, and the finished record is published.
  </p>

  {/* An ordered list of phases, each an ordered list of steps: the order is the
      content, so it is carried by the markup rather than by arrow glyphs. */}
  <ol class="flow" role="list">
    {
      phases.map((phase, phaseIndex) => (
        <li class="flow-phase">
          <p class="flow-phase-name">
            <span class="flow-phase-num">{phaseIndex + 1}</span>
            {phase.name}
            {phase.repeats && <span class="flow-phase-repeat">repeats per part</span>}
          </p>
          <ol class="flow-steps" role="list">
            {phase.steps.map((step) => (
              <li class="flow-step">
                <h3 class="flow-step-name">{step.name}</h3>
                <p class="flow-step-detail">{step.detail}</p>
              </li>
            ))}
          </ol>
        </li>
      ))
    }
  </ol>

  {/* The 9R framework used to have a full section here teaching all ten
      strategies. It is reference material, and the landing page's job is to get
      a visitor to the data, so it moved to the docs beside its canonical
      definitions and is named here in a sentence instead. */}
  <p class="method-lens">
    {/* Explicit spaces: Astro strips the inter-node newline around an <a>. */}
    Finished records are read through the 9R framework, the ten circularity strategies from Refuse
    to Recover that rank how much of a product survives:{' '}
    <a href={frameworkUrl} target="_blank" rel="noopener noreferrer"
      >see the ladder in the docs<span class="visually-hidden"> (opens in new tab)</span></a
    >.
  </p>
</section>

<style>
  .method-steps {
    min-width: 0;
  }

  .method-steps h2 {
    margin: 0 0 0.6rem;
  }

  .method-lede {
    margin: 0 0 1.6rem;
    max-width: 80ch;
    font-size: var(--font-size-body-compact);
    line-height: var(--line-height-body-compact);
    color: var(--color-muted);
  }

  /* Three phases across, collapsing to one column on a narrow screen. No fixed
     min-width and nothing to scale, so it never forces a sideways scroll. */
  .flow {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  .flow-phase {
    display: grid;
    align-content: start;
    gap: 0.9rem;
    border-top: 1px solid var(--color-page-border);
    padding-top: 0.8rem;
  }

  .flow-phase-name {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    font-family: var(--relab-brand-font-mono), monospace;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .flow-phase-num {
    color: var(--color-accent);
  }

  /* The one phase that is a loop rather than a single pass says so, since the
     column layout cannot draw the arrow back on itself. */
  .flow-phase-repeat {
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--color-page-border);
    border-radius: var(--radius-control);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: none;
  }

  .flow-steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.75rem;
    counter-reset: step;
  }

  /* Each step is a hairline row, numbered within its phase by CSS counter so
     the markup carries no presentational numbering. */
  .flow-step {
    counter-increment: step;
    display: grid;
    grid-template-columns: 1.4rem minmax(0, 1fr);
    column-gap: 0.6rem;
  }

  .flow-step::before {
    content: counter(step);
    grid-row: 1 / span 2;
    font-family: var(--relab-brand-font-mono), monospace;
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    line-height: 1.5;
    color: var(--color-muted);
  }

  .flow-step-name {
    margin: 0;
    font-family: var(--relab-brand-font), sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0;
    color: var(--color-on-surface);
  }

  .flow-step-detail {
    margin: 0.15rem 0 0;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  .method-lens {
    margin: 1.8rem 0 0;
    max-width: 80ch;
    font-size: var(--font-size-meta);
    color: var(--color-muted);
  }

  @media (max-width: 900px) {
    .flow {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }
  }
</style>
