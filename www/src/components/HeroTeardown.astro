  .blueprint-parts--plates .blueprint-subpart {
    flex-wrap: wrap;
    gap: 0 0.6rem;
    padding: 0 0 0 0.3rem;
    font-size: var(--relab-type-micro-size);
  }

  .blueprint-subpart-name {
