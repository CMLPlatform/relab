---
// The hero's left column: mark, thesis, nutshell, two CTAs, one headline figure
// and the affiliation. The right column is HeroTeardown (composed in index.astro).
//
// This mark and the sticky header's are never both on screen: on scroll this one
// melts away and the header's fades in (see below and SiteHeader).
import logoUrl from '@/assets/images/logo.svg?url';
import logoDarkUrl from '@/assets/images/logo-dark.svg?url';
import { research } from '@/copy/research.generated.ts';
import { siteMeta } from '@/copy/site-meta.ts';
import { formatCount, type HomeStats } from '@/lib/stats.ts';

interface Props {
  stats: HomeStats | null;
  appUrl: string;
}

const { stats, appUrl } = Astro.props;
const appBase = appUrl.replace(/\/$/, '');
---

<section class="brand-hero">
  {/* Decorative: the header's brand link carries the "Relab" name. The artwork
      is 475x256, so 84px tall is 156px wide; CSS still sizes it. */}
  <div class="brand-hero-logo" aria-hidden="true">
    <img class="brand-light" src={logoUrl} alt="" width="156" height="84" />
    <img class="brand-dark" src={logoDarkUrl} alt="" width="156" height="84" />
  </div>
  <h1 class="brand-hero-title">{siteMeta.heroTitle}</h1>
  <p class="brand-hero-lead">{siteMeta.heroNutshell}</p>
  {/* Two CTAs: reading takes no account, adding does. Each carries its own cost
      on a second line inside the <a>, so it is part of the accessible name. */}
  <div class="brand-hero-actions">
    <a
      href={`${appBase}/products`}
      class="btn btn-primary btn-large btn-stacked"
      target="_blank"
      rel="noopener noreferrer"
    >
      <span class="btn-label">Browse the records</span>
      <span class="btn-sublabel">No account needed</span>
      <span class="visually-hidden"> (opens in new tab)</span>
    </a>
    <a
      href={`${appBase}/new-account`}
      class="btn btn-outline btn-large btn-stacked"
      target="_blank"
      rel="noopener noreferrer"
    >
      <span class="btn-label">Contribute a teardown</span>
      <span class="btn-sublabel">Free account, takes a minute</span>
      <span class="visually-hidden"> (opens in new tab)</span>
    </a>
  </div>
  {
    /* One figure, baked at build time and refreshed after load
       (landing-refresh.ts). Always rendered: the refresh keys off this node's
       presence, so a build-time stats failure must not remove it. Hidden until
       a real number exists. */
    <p class="brand-hero-metrics" data-metrics hidden={!stats}>
      {stats ? `${formatCount(stats.totals.parts)} parts documented` : ''}
    </p>
  }
  <p class="brand-hero-affiliation">{research.affiliation}</p>
</section>

<script>
  import { refreshLanding } from '@/scripts/landing-refresh.ts';

  refreshLanding().catch(() => {
    // Best-effort refresh: any failure leaves the baked metrics as-is.
  });
</script>

<style>
  /* Left-aligned and ragged right. */
  .brand-hero {
    display: grid;
    align-content: start;
    gap: 1.1rem;
    padding-top: 0.5rem;
  }

  .brand-hero-logo img {
    display: block;
    height: clamp(60px, 6vw, 84px);
    width: auto;
  }

  /* Theme-swapped mark, mirroring SiteHeader/SiteFooter. */
  .brand-hero-logo .brand-dark {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .brand-hero-logo .brand-light {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .brand-hero-logo .brand-dark {
      display: block;
    }
  }

  :global(:root[data-theme='dark']) .brand-hero-logo .brand-light {
    display: none;
  }

  :global(:root[data-theme='dark']) .brand-hero-logo .brand-dark {
    display: block;
  }

  /* The handoff: on scroll this mark dissolves upward while the header's fades
     in (SiteHeader). `animation-timeline: scroll()` is Chromium and WebKit only
     (Firefox returned false from CSS.supports() on 2026-08-13), so on Firefox
     and under reduced motion BOTH marks stay visible. Accepted fallback; do not
     treat the two-marks state as unreachable. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      /* Longhands, never the `animation` shorthand: the minifier folds it with
         animation-timeline into `animation: … scroll(root)`, which no browser parses. */
      .brand-hero-logo {
        animation-name: brand-hero-logo-melt;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root);
        animation-range: 0 140px;
        transform-origin: left top;
      }
    }
  }

  @keyframes brand-hero-logo-melt {
    to {
      opacity: 0;
      transform: scale(0.86) translateY(-10px);
    }
  }

  /* Display size from assets/DESIGN.md's web scale (38/44), floored for phones.
     `text-wrap: balance` picks the line break; a `ch` cap kept splitting
     "circular-economy" at its hyphen because a serif "0" is a poor proxy for
     mixed-case width. The cap is only a ceiling. */
  .brand-hero-title {
    margin: 0;
    max-width: 30ch;
    font-size: clamp(2rem, 3.2vw, 2.375rem);
    line-height: 1.16;
    text-wrap: balance;
  }

  .brand-hero-lead {
    margin: 0;
    max-width: 48ch;
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    color: var(--color-muted);
  }

  .brand-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 0.2rem;
  }

  .brand-hero-affiliation {
    margin: 0;
    font-size: var(--font-size-meta);
    color: var(--color-muted);
  }

  /* Hairline above the provenance line. */
  .brand-hero-affiliation {
    max-width: 44ch;
    padding-top: 0.9rem;
    border-top: 1px solid var(--color-page-border);
  }

  .brand-hero-metrics {
    margin: 0;
    font-family: var(--relab-brand-font-mono), monospace;
    font-size: var(--relab-type-data-size);
    font-variant-numeric: tabular-nums;
    color: var(--color-muted);
  }

  /* Fade while landing-refresh.ts replaces the baked totals, so the change does
     not read as a glitch. Opacity only: no layout shift. */
  @media (prefers-reduced-motion: no-preference) {
    .brand-hero-metrics {
      transition: opacity 180ms var(--ease-out);
    }

    .brand-hero-metrics.is-refreshing {
      opacity: 0.35;
    }
  }

</style>
