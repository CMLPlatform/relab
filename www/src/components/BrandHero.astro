---
import logoSvg from '@/assets/images/logo.svg?raw';
// The brand hero: the large logo, the page's thesis, a one-line nutshell, the
// dataset CTA, and the live totals. On scroll the logo hands off to the sticky
// header's logo (see the scroll-driven animation below and in SiteHeader).
// `?raw`: the logo is inlined rather than linked, because the ring — the <circle>
// the 9R loop is drawn from — has to be reachable from CSS to draw itself in.
// Costs the /_astro/ hashed-asset caching on this one file (~3KB per variant,
// inline) and saves the request. CSS paints only one of the two variants.
import logoDarkSvg from '@/assets/images/logo-dark.svg?raw';
import { siteMeta } from '@/copy/site-meta.ts';
import { formatCount, type HomeStats } from '@/lib/stats.ts';

interface Props {
  stats: HomeStats | null;
  appUrl: string;
}

const { stats, appUrl } = Astro.props;
const appBase = appUrl.replace(/\/$/, '');
---

<section class="brand-hero content-reveal">
  {/* Decorative here: the sticky header's brand link carries the "Relab" name.
      The theme classes sit on wrappers rather than the inlined <svg> itself, so
      the artwork stays byte-for-byte what `just assets-sync` produced. */}
  <div class="brand-hero-logo" aria-hidden="true">
    <div class="brand-light" set:html={logoSvg} />
    <div class="brand-dark" set:html={logoDarkSvg} />
  </div>
  <h1 class="brand-hero-title">{siteMeta.heroTitle}</h1>
  <p class="brand-hero-lead">{siteMeta.heroNutshell}</p>
  <div class="brand-hero-actions">
    <a
      href={`${appBase}/products`}
      class="btn btn-primary btn-large"
      target="_blank"
      rel="noopener noreferrer"
    >
      Explore the dataset<span class="visually-hidden"> (opens in new tab)</span>
    </a>
  </div>
  {
    stats && (
      <p class="brand-hero-metrics" data-metrics>
        {formatCount(stats.totals.teardowns)} teardowns · {formatCount(stats.totals.parts)} parts ·{' '}
        {formatCount(stats.totals.mass_kg)} kg logged
      </p>
    )
  }
</section>

<script>
  import { refreshLanding } from '@/scripts/landing-refresh.ts';

  refreshLanding().catch(() => {
    // Best-effort refresh: any failure leaves the baked metrics as-is.
  });
</script>

<style>
  .brand-hero {
    display: grid;
    justify-items: center;
    gap: 1.1rem;
    padding: 1.5rem 0 0.5rem;
    text-align: center;
  }

  /* :global — Astro cannot add its scope attribute to `set:html` markup. */
  .brand-hero-logo :global(svg) {
    display: block;
    height: clamp(80px, 11vw, 128px);
    width: auto;
  }

  /* Theme-swapped logo, mirroring SiteHeader/SiteFooter. */
  .brand-hero-logo .brand-dark {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .brand-hero-logo .brand-light {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .brand-hero-logo .brand-dark {
      display: block;
    }
  }

  :global(:root[data-theme='dark']) .brand-hero-logo .brand-light {
    display: none;
  }

  :global(:root[data-theme='dark']) .brand-hero-logo .brand-dark {
    display: block;
  }

  /* No measure cap on the title: it is short enough to hold one line on
     desktop and wraps on its own once the viewport narrows. */
  .brand-hero-title {
    margin: 0;
  }

  .brand-hero-lead {
    margin: 0;
    max-width: 72ch;
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    color: var(--color-muted);
  }

  .brand-hero-actions {
    margin-top: 0.2rem;
  }

  .brand-hero-metrics {
    margin: 0;
    font-family: var(--relab-brand-font-mono), monospace;
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-muted);
  }

  /* The totals are baked at build time and refreshed from the API after load
     (landing-refresh.ts). Without this the figures change with no explanation,
     which reads as a glitch rather than as freshness. Opacity only: the line
     must not move, so the refresh keeps its no-layout-shift guarantee. */
  @media (prefers-reduced-motion: no-preference) {
    .brand-hero-metrics {
      transition: opacity 180ms var(--ease-out);
    }

    .brand-hero-metrics.is-refreshing {
      opacity: 0.35;
    }
  }

  /* The ring closes: on load the mark's circle — the 9R loop — draws itself,
     and the letters fade up behind it so the loop lands last. The only authored
     entrance on the site; everything else here is feedback or continuity.
     Both rules live inside the no-preference query, so the default state is the
     finished logo: reduced motion and a failed stylesheet both show the mark. */
  @media (prefers-reduced-motion: no-preference) {
    /* 2πr for the mark's r="771.6", rounded up so the ends overlap rather than
       leave a hairline gap. Fixed because the artwork's geometry is fixed —
       if the ring is ever regenerated at another radius, this follows it. */
    .brand-hero-logo :global(circle) {
      stroke-dasharray: 4849;
      stroke-dashoffset: 4849;
      animation: ring-draw 600ms var(--ease-out) forwards;
    }

    /* Every letter group, but not the ring: the <circle> is a top-level sibling
       of the four <g> wordmark groups, so it keeps its own timing above. */
    .brand-hero-logo :global(g) {
      opacity: 0;
      animation: ring-letters-in 300ms var(--ease-out) 80ms forwards;
    }
  }

  /* Starts at 3 o'clock, where an SVG circle's path begins. Rotating the start
     to 12 needs a transform-origin in user units on a viewBox that is already
     offset — not worth the fragility for a quarter turn nobody is timing. */
  @keyframes ring-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes ring-letters-in {
    to {
      opacity: 1;
    }
  }

  /* The melt: as the page scrolls the hero logo dissolves upward while the
     header logo fades in (SiteHeader). Scroll-driven and reduced-motion-gated,
     so unsupported browsers simply keep the logo static and visible. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      /* Longhands, never the `animation` shorthand: the CSS minifier folds a
         shorthand plus animation-timeline into `animation: … scroll(root)`,
         which no browser parses, silently killing the effect. */
      .brand-hero-logo {
        animation-name: brand-hero-logo-melt;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root);
        animation-range: 0 180px;
        transform-origin: center top;
      }
    }
  }

  @keyframes brand-hero-logo-melt {
    to {
      opacity: 0;
      transform: scale(0.86) translateY(-10px);
    }
  }
</style>
