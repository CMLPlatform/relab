---

import { siteMeta } from '@/copy/site-meta.ts';

interface Props {
  appUrl: string;
  docsUrl: string;
  githubUrl: string;
}

const { appUrl, docsUrl, githubUrl } = Astro.props;
---

<section class="hero-panel card content-reveal">
  <div class="hero-copy">
    <!-- both variants carry the alt: display:none removes the hidden one from
         the accessibility tree, so exactly one name is exposed per theme -->
    <h1 class="hero-brand">
      <img class="hero-logo brand-light" src="/images/logo.svg" alt={siteMeta.title} width="467" height="256" />
      <img class="hero-logo brand-dark" src="/images/logo-dark.svg" alt={siteMeta.title} width="467" height="256" />
    </h1>
    <p class="hero-lead">{siteMeta.defaultDescription}</p>

    <div class="hero-actions">
      <a
        href={appUrl}
        class="btn btn-primary btn-large"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Open the Relab app"
      >
        Open the app
      </a>
      <a
        href={docsUrl}
        class="btn btn-muted btn-large"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Read the Relab documentation"
      >
        Read the docs
      </a>
      <a
        href={githubUrl}
        class="btn btn-muted btn-large"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Browse the Relab source code on GitHub"
      >
        Browse source
      </a>
    </div>
  </div>
</section>

<style>
  .hero-brand {
    margin: 0 0 0.75rem;
  }
  .hero-logo {
    /* the ringed wordmark is the title now — wide lockup, sized by height */
    height: clamp(88px, 14vw, 132px);
    width: auto;
  }
  /* theme-swapped mark: teal on light, cyan on dark (system + manual toggle) */
  .brand-light {
    display: block;
  }
  .brand-dark {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .brand-light {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .brand-dark {
      display: block;
    }
  }
  :global(:root[data-theme='dark']) .brand-light {
    display: none;
  }
  :global(:root[data-theme='dark']) .brand-dark {
    display: block;
  }
</style>
