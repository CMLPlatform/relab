---
// Slim brand bar: the wordmark plus the three places visitors actually go.
// The landing hero keeps the page's h1; this is navigation, not a heading.
interface Props {
  appUrl: string;
  docsUrl: string;
  githubUrl: string;
}

const { appUrl, docsUrl, githubUrl } = Astro.props;
---

<header class="site-header">
  <div class="site-header-inner">
    {/* The link carries the name: whichever logo the theme shows is
        display: none in the other theme, which would leave the link nameless. */}
    <a href="/" class="site-header-brand" aria-label="Relab">
      <img class="brand-light" src="/images/logo.svg" alt="" aria-hidden="true" height="38" />
      <img class="brand-dark" src="/images/logo-dark.svg" alt="" aria-hidden="true" height="38" />
    </a>
    <nav class="site-header-nav" aria-label="Site">
      <a href={appUrl} target="_blank" rel="noopener noreferrer">App</a>
      <a href={docsUrl} target="_blank" rel="noopener noreferrer">Docs</a>
      <a href={githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
    </nav>
  </div>
</header>

<style>
  /* Sticky, flat and sharp: a translucent blurred surface with a hairline
     bottom rule — no shadow. Keeps App/Docs/GitHub reachable down the page. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--color-page-surface) 82%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-page-border);
  }

  /* Full-bleed bar, content aligned with the page column. */
  .site-header-inner {
    width: min(calc(100% - 2rem), var(--content-width));
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.55rem 0;
  }

  .site-header-brand {
    display: inline-flex;
    align-items: center;
  }

  .site-header-brand img {
    display: block;
    height: 38px;
    width: auto;
  }

  .site-header-nav {
    display: flex;
    gap: 1.25rem;
  }

  .site-header-nav a {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-on-surface);
    text-decoration: none;
  }

  .site-header-nav a:hover,
  .site-header-nav a:focus-visible {
    color: var(--color-primary);
    text-decoration: underline;
  }

  /* Theme-swapped logo, mirroring SiteFooter's pattern. The parent class is
     required: `.site-header-brand img` above outweighs a bare `.brand-dark`. */
  .site-header-brand .brand-dark {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .brand-light {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .brand-dark {
      display: block;
    }
  }

  :global(:root[data-theme='dark']) .brand-light {
    display: none;
  }

  :global(:root[data-theme='dark']) .brand-dark {
    display: block;
  }

  /* The melt: the hero's large logo dissolves as the page scrolls (BrandHero)
     while this one fades in to take its place. Scroll-driven and
     reduced-motion-gated; without support the logo is simply always visible. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      /* Longhands, never the `animation` shorthand — see BrandHero. */
      .site-header-brand {
        animation-name: site-header-logo-in;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root);
        animation-range: 90px 180px;
      }
    }
  }

  @keyframes site-header-logo-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
