# Website task runner
# Run `just --list` to see the recipes in this file.
# Run from www/, or from the repo root as `just www/<recipe>`.
# This file holds the composite recipes and everything the root justfile calls.
# For day-to-day work, `pnpm run <script>` works too; see package.json.

import '../playwright.just'

# Show available recipes
default:
    @just --list

# Install dependencies
install:
    pnpm install --frozen-lockfile

# Upgrade Astro and its official integrations, then apply the in-range pnpm updates.
# This uses `pnpm up` without --latest, so majors stay intentional: opt in via Renovate.
update:
    pnpm dlx @astrojs/upgrade
    pnpm up
    pnpm dedupe

# Lint the code
lint:
    pnpm run lint

# Run static type checks
typecheck:
    pnpm run typecheck

# Start the standalone dev server against the root full-stack dev origins
dev:
    #!/usr/bin/env bash
    set -euo pipefail
    export PUBLIC_APP_URL="${PUBLIC_APP_URL:-http://127.0.0.1:8011}"
    export PUBLIC_DOCS_URL="${PUBLIC_DOCS_URL:-http://127.0.0.1:8012}"
    export PUBLIC_SITE_URL="${PUBLIC_SITE_URL:-http://127.0.0.1:8013}"
    export PUBLIC_API_URL="${PUBLIC_API_URL:-http://127.0.0.1:8010}"
    pnpm run dev

# Auto-format code with Biome
format:
    pnpm run format

# Auto-fix lint issues and format code
fix:
    pnpm run fix

# Run the quality gate
check: lint typecheck

# Build the production site
build:
    #!/usr/bin/env bash
    set -euo pipefail
    # Local production-mode build against the reference deployment's origins.
    # Export *_PUBLIC_URL to override one. Compose passes the host's .env values as
    # build args instead.
    export PUBLIC_APP_URL="${APP_PUBLIC_URL:-https://app.cml-relab.org}"
    export PUBLIC_DOCS_URL="${DOCS_PUBLIC_URL:-https://docs.cml-relab.org}"
    export PUBLIC_SITE_URL="${SITE_PUBLIC_URL:-https://cml-relab.org}"
    export PUBLIC_API_URL="${API_PUBLIC_URL:-https://api.cml-relab.org}"
    export PUBLIC_FEATURED_PRODUCT_ID="${FEATURED_PRODUCT_ID:-}"
    pnpm run build

# Run the unit tests
test:
    pnpm run test

# Run the CI test suite
test-ci:
    pnpm run test:ci

# Run the browser E2E tests against a fresh production build, because a stale dist/
# silently tests old code. CI runs chromium only. Locally, every configured browser runs.
test-e2e: build _browsers
    pnpm run test:e2e {{ if env("CI", "") != "" { "--project=chromium" } else { "" } }}

# Run the full cross-browser E2E matrix: chromium, firefox, and webkit
test-e2e-cross-browser: build _browsers
    pnpm run test:e2e

# Port the E2E backend is mapped to on the host (must match compose.e2e.yaml / E2E_BACKEND_PORT)
e2e_backend_port := env("E2E_BACKEND_PORT", "18010")
e2e_api_url := "http://127.0.0.1:" + e2e_backend_port

# Build against the running E2E backend, so that the hero renders a live record.
# The committed fixture ships one URL per photograph, so it cannot produce a srcset.
# Only a real API response carries the width-keyed derivative map.
# The origins below match `build`, except for the API and the featured product.
build-e2e:
    #!/usr/bin/env bash
    set -euo pipefail
    export PUBLIC_APP_URL="${APP_PUBLIC_URL:-https://app.cml-relab.org}"
    export PUBLIC_DOCS_URL="${DOCS_PUBLIC_URL:-https://docs.cml-relab.org}"
    export PUBLIC_SITE_URL="${SITE_PUBLIC_URL:-https://cml-relab.org}"
    export PUBLIC_API_URL="{{ e2e_api_url }}"
    # The seeded Dell XPS 13: the one product whose components carry photographs.
    # Seeding runs against an empty database, so its id is stable.
    export PUBLIC_FEATURED_PRODUCT_ID="${E2E_FEATURED_PRODUCT_ID:-2}"
    pnpm run build

# Run the live-data E2E lane. Needs the compose.e2e.yaml stack; see root test-e2e-full-stack.
test-e2e-live: build-e2e _browsers
    WWW_E2E_LIVE=1 pnpm run test:e2e --project=chromium

# Run the full CI pipeline locally
ci: check test-ci

# Clean caches and build artifacts
clean:
    rm -rf .astro coverage dist playwright-report test-results junit.xml
