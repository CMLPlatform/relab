# Relab scheduled job: backup repository maintenance. Instance is the environment, e.g. relab-backup-maintenance@prod.
#
# Do not install by hand — `just timers-install <env>` renders these for this host
# (checkout path, deploy user, `just` location) and enables them. The committed values
# are placeholders; an unrendered unit runs as the wrong user in the wrong directory and
# stays silent until its first fire.
#
# NOTE: the deploy user needs docker-group membership, which is root-equivalent on the
# host. These units run a writable git checkout as unattended, scheduled, effectively
# root-level jobs — treat that directory as privileged.
[Unit]
Description=Relab backup maintenance: retention, integrity check, offsite copy (%i)
Documentation=file:/opt/relab/deploy/DEPLOY-PROD.md
Requires=docker.service
After=docker.service
# Bound retries: at RestartSec=15min the default start-limit window (5 in 10s) can
# never trip, so a persistently failing maintenance run — broken repo, unreachable
# offsite remote — would otherwise repack and re-copy forever, flapping the /fail
# ping. Three tries, then the unit lands in `failed`, which the watchdog's timer
# check reports once and clearly. A 1d window is fine here because the timer is
# daily; the hourly relab-backup@ unit needs a shorter one.
StartLimitIntervalSec=1d
StartLimitBurst=3

[Service]
Type=oneshot
User=relab
WorkingDirectory=/opt/relab
# Dead-man's-switch URL, one per job. Host-local and never committed; `-` means the
# file is optional and a missing one simply disables pinging.
EnvironmentFile=-/etc/relab/relab.env
Environment=JUST_BIN=/usr/bin/just
Environment=BACKUP_MAINTENANCE=only
ExecStart=/opt/relab/scripts/run_scheduled.sh backup-maintenance %i
TimeoutStartSec=7200
# `compose run` starts a container that is a child of dockerd, NOT of this unit's
# cgroup. If systemd SIGKILLs us on timeout, --rm never fires and the container is left
# holding the 0400 secret copies and internet egress. Reap it.
ExecStopPost=-/usr/bin/docker rm -f relab-backup-maintenance-%i
# Maintenance is not on the data path — the hourly snapshots keep arriving whether or
# not this succeeds — but a repository that is never pruned or copied offsite degrades
# quietly, so retry rather than waiting a full day.
Restart=on-failure
RestartSec=15min
# CPU: niced, so it still gets a guaranteed slice, just a small one.
Nice=10
# I/O: best-effort/7, deliberately NOT idle. A host that also runs compute jobs can keep
# the best-effort class saturated for hours, and under `idle` the kernel serves this only
# when nothing else has pending I/O — starving the backup until the timeout kills it.
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
# Nothing: triggered by relab-backup-maintenance@%i.timer, never enabled directly.
