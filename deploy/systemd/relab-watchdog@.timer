# Relab scheduled job: health watchdog. Instance is the environment, e.g. relab-watchdog@prod.
#
# Do not install by hand — `just timers-install <env>` renders these for this host
# (checkout path, deploy user, `just` location) and enables them. The committed values
# are placeholders; an unrendered unit runs as the wrong user in the wrong directory and
# stays silent until its first fire.
#
# NOTE: the deploy user needs docker-group membership, which is root-equivalent on the
# host. These units run a writable git checkout as unattended, scheduled, effectively
# root-level jobs — treat that directory as privileged.
[Unit]
Description=Relab health watchdog schedule (%i)

[Timer]
# No RandomizedDelaySec. That exists to stop a fleet stampeding a shared endpoint at
# the same instant; Relab is two hosts on separate machines, so it buys nothing here and
# costs determinism — a predictable schedule is easier to reason about and lets the
# watchdog's staleness check run a tighter threshold.
# Jitter is actively unhelpful on a monitoring job: it stretches the interval to as much
# as 65 minutes and delays detection, for a check that does almost no I/O.
OnCalendar=hourly
# Fire on boot when downtime crossed an hourly boundary, like the other two timers:
# the first thing a host that was just down should do is check itself.
Persistent=true

[Install]
WantedBy=timers.target
