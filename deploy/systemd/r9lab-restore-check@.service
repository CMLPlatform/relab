# R9lab scheduled job: backup restore verification. Instance is the environment, e.g. r9lab-restore-check@prod.
#
# Do not install by hand — `just timers-install <env>` renders these for this host
# (checkout path, deploy user, `just` location) and enables them. The committed values
# are placeholders; an unrendered unit runs as the wrong user in the wrong directory and
# stays silent until its first fire.
#
# NOTE: the deploy user needs docker-group membership, which is root-equivalent on the
# host. These units run a writable git checkout as unattended, scheduled, effectively
# root-level jobs — treat that directory as privileged.
[Unit]
Description=R9lab backup restore verification (%i)
Documentation=file:/opt/r9lab/deploy/DEPLOY-PROD.md
Requires=docker.service
After=docker.service
# Ordering only, for when both are queued: after an outage, Persistent=true fires every
# timer at boot at once, collapsing the 02:30/06:00 gap that normally keeps the
# maintenance prune away from this job's --no-lock restore. A prune deleting pack files
# mid-restore looks like archive corruption.
After=r9lab-backup-maintenance@%i.service

[Service]
Type=oneshot
User=r9lab
WorkingDirectory=/opt/r9lab
# Dead-man's-switch URL, one per job. Host-local and never committed; `-` means the
# file is optional and a missing one simply disables pinging.
EnvironmentFile=-/etc/r9lab/r9lab.env
Environment=JUST_BIN=/usr/bin/just
Environment=PATH=/var/lib/r9lab/.local/bin:/usr/local/bin:/usr/bin:/bin:/snap/bin
ExecStart=/opt/r9lab/scripts/run_scheduled.sh restore-check %i
TimeoutStartSec=7200
# The scratch Postgres container is a child of dockerd, not of this cgroup. If systemd
# SIGKILLs the job on timeout, no shell trap runs and the container keeps serving a full
# restored copy of production data. backup_restic_ops.sh passes the deterministic name
# r9lab-restore-check-<env> so this can reap it.
ExecStopPost=-/usr/bin/docker rm -f r9lab-restore-check-%i
# Same for the uploads restore container, which holds a full copy of the uploads volume.
ExecStopPost=-/usr/bin/docker rm -f r9lab-restore-check-%i-uploads
# And the restored uploads tree: a full decrypted copy of user uploads that would
# otherwise sit on the backup filesystem until next month. The path comes from the repo's
# .env, so the script resolves it -- this subcommand only removes the scratch tree.
ExecStopPost=-/opt/r9lab/scripts/backup_restic_ops.sh restore-check-clean %i
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
# Nothing: triggered by r9lab-restore-check@%i.timer, never enabled directly.
