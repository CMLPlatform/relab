# deploy/env/staging.compose.env - committed, non-secret Compose interpolation vars for staging.
# Loaded by the root deploy recipes. Host-local operator inputs live in the
# gitignored root `.env` on each deploy host; runtime secrets live in secrets/staging/.

# Project identity stamped on every signal, and what the central stack's
# ProjectTelemetrySilent rule keys on. Must match `bootstrap.sh <project> <env>`.
PROJECT=relab
ENVIRONMENT=staging
API_PUBLIC_URL=https://api-test.cml-relab.org
APP_PUBLIC_URL=https://app-test.cml-relab.org
SITE_PUBLIC_URL=https://web-test.cml-relab.org
DOCS_PUBLIC_URL=https://docs-test.cml-relab.org
# Empty: staging data has no stable featured product, so the landing hero
# renders the committed fixture.
FEATURED_PRODUCT_ID=

# Offsite restic repository. The credential is a SURFdrive share link scoped to this
# environment's folder, so the share root IS the repository and the path is empty.
# The remote NAME is per environment on purpose: it is now the only committed thing
# that distinguishes the two, so a secrets/<env>/rclone.conf deployed to the wrong
# host fails with "remote not found" instead of silently writing prod snapshots into
# staging's repository. Credentials live in secrets/staging/rclone.conf (not committed).
RESTIC_OFFSITE_REPOSITORY=rclone:surfdrive_staging:
