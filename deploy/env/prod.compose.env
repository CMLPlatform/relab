# deploy/env/prod.compose.env - committed, non-secret Compose interpolation vars for prod.
# Loaded by the root deploy recipes. Host-local operator inputs live in the
# gitignored root `.env` on each deploy host; runtime secrets live in secrets/prod/.

# Project identity stamped on every signal, and what the central stack's
# ProjectTelemetrySilent rule keys on. Must match `bootstrap.sh <project> <env>`.
PROJECT=relab
ENVIRONMENT=prod
API_PUBLIC_URL=https://api.cml-relab.org
APP_PUBLIC_URL=https://app.cml-relab.org
SITE_PUBLIC_URL=https://cml-relab.org
DOCS_PUBLIC_URL=https://docs.cml-relab.org
# Product whose teardown the www landing hero features (fixture fallback when unset).
FEATURED_PRODUCT_ID=464

# Offsite restic repository. The credential is a SURFdrive share link scoped to this
# environment's folder, so the share root IS the repository and the path is empty.
# The remote NAME is per environment on purpose: it is now the only committed thing
# that distinguishes the two, so a secrets/<env>/rclone.conf deployed to the wrong
# host fails with "remote not found" instead of silently writing prod snapshots into
# staging's repository. Credentials live in secrets/prod/rclone.conf (not committed).
RESTIC_OFFSITE_REPOSITORY=rclone:surfdrive_prod:
